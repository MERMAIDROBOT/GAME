# Match clean_build.filesystem_metadata without hiding unknown ._ source files.
function(ps2_port_filter_metadata output)
    set(result)
    foreach(path IN LISTS ARGN)
        get_filename_component(name "${path}" NAME)
        get_filename_component(parent "${path}" DIRECTORY)
        if(name MATCHES "^\\._" AND NOT IS_SYMLINK "${path}")
            string(SUBSTRING "${name}" 2 -1 companion_name)
            set(companion "${parent}/${companion_name}")
            if(EXISTS "${companion}" AND NOT IS_SYMLINK "${companion}")
                file(READ "${path}" header LIMIT 8 HEX)
                if(header STREQUAL "0005160700020000")
                    continue()
                endif()
            endif()
        endif()
        list(APPEND result "${path}")
    endforeach()
    set(${output} "${result}" PARENT_SCOPE)
endfunction()
