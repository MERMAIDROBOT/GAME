# Generic overlay: no retail game code is placed in the public tool repository.
if(CMAKE_CURRENT_SOURCE_DIR STREQUAL PS2_PORT_UPSTREAM)
    function(ps2_port_attach_game)
        if(NOT PS2_PORT_GENERATED_DIR)
            return()
        endif()
        if(NOT TARGET ps2EntryRunner)
            message(FATAL_ERROR "PS2Recomp runtime target is missing")
        endif()
        # Preserve paired Apple framework flags when CMake deduplicates options.
        if(TARGET PkgConfig::FFMPEG AND APPLE)
            get_target_property(ff_options PkgConfig::FFMPEG INTERFACE_LINK_OPTIONS)
            set(grouped_options "")
            set(expect_framework OFF)
            foreach(option IN LISTS ff_options)
                if(expect_framework)
                    list(APPEND grouped_options "SHELL:-framework ${option}")
                    set(expect_framework OFF)
                elseif(option STREQUAL "-framework")
                    set(expect_framework ON)
                elseif(NOT option MATCHES "NOTFOUND$")
                    list(APPEND grouped_options "${option}")
                endif()
            endforeach()
            set_property(TARGET PkgConfig::FFMPEG PROPERTY INTERFACE_LINK_OPTIONS "${grouped_options}")
        endif()
        file(GLOB game_cpp CONFIGURE_DEPENDS "${PS2_PORT_GENERATED_DIR}/*.cpp")
        if(NOT game_cpp)
            message(FATAL_ERROR "No generated game files")
        endif()
        get_target_property(runner_sources ps2EntryRunner SOURCES)
        list(FILTER runner_sources EXCLUDE REGEX "/src/runner/register_functions\\.cpp$")
        set_property(TARGET ps2EntryRunner PROPERTY SOURCES "${runner_sources}")
        target_sources(ps2EntryRunner PRIVATE ${game_cpp})
        # Keep optimized link cache private beside the generated game build.
        if(APPLE AND CMAKE_CXX_COMPILER_ID STREQUAL "AppleClang")
            file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/thinlto-cache")
            target_link_options(ps2EntryRunner PRIVATE
                "LINKER:-cache_path_lto,${CMAKE_BINARY_DIR}/thinlto-cache")
        endif()
        target_include_directories(ps2EntryRunner BEFORE PRIVATE "${PS2_PORT_GENERATED_DIR}")
        if(PS2_PORT_TEST_SOURCE)
            add_executable(ps2PortRuntimeTests "${PS2_PORT_TEST_SOURCE}")
            target_link_libraries(ps2PortRuntimeTests PRIVATE ps2_runtime)
            get_filename_component(port_test_directory "${PS2_PORT_TEST_SOURCE}" DIRECTORY)
            add_executable(ps2PortIopImportTests "${PS2_PORT_UPSTREAM}/ps2xIOP/tests/iop_import_tests.cpp")
            target_include_directories(ps2PortIopImportTests PRIVATE "${PS2_PORT_UPSTREAM}/ps2xIOP/src")
            target_link_libraries(ps2PortIopImportTests PRIVATE ps2_iop)
            add_executable(ps2PortPresentationTests "${port_test_directory}/host_presentation.cpp")
            target_link_libraries(ps2PortPresentationTests PRIVATE ps2_runtime)
            add_executable(ps2PortHostPadTests "${port_test_directory}/host_pad.cpp"
                "${PS2_PORT_UPSTREAM}/ps2xRuntime/src/lib/ps2_pad.cpp")
            target_include_directories(ps2PortHostPadTests PRIVATE
                "${PS2_PORT_UPSTREAM}/ps2xRuntime/include"
                $<TARGET_PROPERTY:raylib,INTERFACE_INCLUDE_DIRECTORIES>)
            set_target_properties(ps2PortHostPadTests PROPERTIES CXX_STANDARD 20)
            # Exercise the upstream VU interpreter using synthetic programs only.
            file(WRITE "${CMAKE_BINARY_DIR}/port_vu_test_main.cpp"
                "#include \"MiniTest.h\"\nvoid register_ps2_vu1_tests();\nvoid reset_ps2_test_function_table();\nint main() { MiniTest::BeforeEach(reset_ps2_test_function_table); register_ps2_vu1_tests(); return MiniTest::Run(); }\n")
            add_executable(ps2PortVuTests
                "${CMAKE_BINARY_DIR}/port_vu_test_main.cpp"
                "${PS2_PORT_UPSTREAM}/ps2xTest/src/ps2_vu1_tests.cpp"
                "${PS2_PORT_UPSTREAM}/ps2xTest/src/test_function_table.cpp")
            target_include_directories(ps2PortVuTests PRIVATE "${PS2_PORT_UPSTREAM}/ps2xTest/include")
            target_link_libraries(ps2PortVuTests PRIVATE ps2_runtime)
        endif()
        if(PS2_PORT_VU_COMPILER_SOURCE)
            add_executable(ps2PortVuRecompiler "${PS2_PORT_VU_COMPILER_SOURCE}"
                "${PS2_PORT_UPSTREAM}/ps2xTest/src/test_function_table.cpp")
            target_include_directories(ps2PortVuRecompiler PRIVATE
                "${PS2_PORT_UPSTREAM}/ps2xRuntime/src/lib/vu"
                "${PS2_PORT_UPSTREAM}/ps2xTest/include")
            target_link_libraries(ps2PortVuRecompiler PRIVATE ps2_runtime)
        endif()
        if(PS2_PORT_VU_COMPILED_DIR)
            file(GLOB vu_cpp CONFIGURE_DEPENDS "${PS2_PORT_VU_COMPILED_DIR}/*.cpp")
            if(NOT vu_cpp)
                message(FATAL_ERROR "Compiled vector source set is empty")
            endif()
            target_include_directories(ps2EntryRunner PRIVATE "${PS2_PORT_UPSTREAM}/ps2xRuntime/src/lib/vu")
            target_sources(ps2EntryRunner PRIVATE ${vu_cpp})
        endif()
        message(STATUS "Attached local generated game code")
    endfunction()
    cmake_language(DEFER CALL ps2_port_attach_game)
endif()
