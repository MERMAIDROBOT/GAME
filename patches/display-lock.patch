+                // Average whole-refresh steps only; a skipped callback is two periods.
+                if (step > 4'000'000 && step < 45'000'000) {
+                    const int64_t n = p ? (step + p / 2) / p : 1;
+                    const int64_t one = step / (n ? n : 1);
+                    periodNs.store(p ? p + (one - p) / 16 : one, std::memory_order_relaxed);
+                }
+            }
+            lastNs.store(at, std::memory_order_release);
+            {
+                std::lock_guard<std::mutex> lock(mutex);
