+        DisplayClock &clock = displayClock();
+        if (clock.started) return true;
+#if defined(__APPLE__)
+        using Create = int32_t (*)(void **);
+        using SetCallback = int32_t (*)(void *, int32_t (*)(void *, const void *, const void *, uint64_t, uint64_t *, void *), void *);
+        using Start = int32_t (*)(void *);
