+    }
+    struct DisplayClock
+    {
+        std::atomic<int64_t> lastNs{0};   // steady_clock time of the latest display refresh
+        std::atomic<int64_t> periodNs{0}; // measured refresh period
+        std::atomic<uint64_t> count{0};
+        std::mutex mutex;
+        std::condition_variable cv;
+        bool started = false;
+        // Called on every refresh (the display link thread). `hostTime` is mach_absolute_time of that refresh.
+        void refreshed(uint64_t hostTime, int64_t nowNs, uint64_t machNow, uint32_t numer, uint32_t denom)
+        {
+            const int64_t age = machNow > hostTime ? int64_t((machNow - hostTime) * numer / denom) : 0;
+            const int64_t at = nowNs - (age < 50'000'000 ? age : 0);
+            const int64_t previous = lastNs.load(std::memory_order_relaxed);
+            if (previous && at > previous) {
