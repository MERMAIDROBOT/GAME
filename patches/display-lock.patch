+    inline int32_t displayLinkCallback(void *, const void *now, const void *, uint64_t, uint64_t *, void *)
+    {
+        static const mach_timebase_info_data_t base = [] { mach_timebase_info_data_t b{}; mach_timebase_info(&b); return b; }();
+        uint64_t hostTime = 0;
