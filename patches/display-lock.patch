+    // once per refresh, and the emulated vertical blank is phase-locked half a refresh away from it. Two free-running
+    // 60 Hz clocks otherwise beat against each other: a field finished near a refresh edge reaches the panel one
+    // refresh early or late (seen as judder at a steady frame rate), and a vsync'd swap blocks unevenly.
+    inline bool displayLockRequested()
+    {
+        static const bool value = [] {
+            const char *v = std::getenv("PS2_PORT_ENHANCE_DISPLAY_LOCK");
+            return vsync() && v && v[0] == '1' && !v[1];
+        }();
+        return value;
+    }
+    inline int64_t steadyNs()
