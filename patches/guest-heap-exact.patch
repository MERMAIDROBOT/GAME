diff --git a/ps2xRuntime/include/runtime/guest_heap_layout.h b/ps2xRuntime/include/runtime/guest_heap_layout.h
new file mode 100644
index 0000000..b298d92
--- /dev/null
+++ b/ps2xRuntime/include/runtime/guest_heap_layout.h
@@ -0,0 +1,25 @@
+#pragma once
+// SetupHeap layout rule. An explicit heap size whose end lies above the default "rest of RAM" end is the title's
+// exact heap: the title placed a small C-library heap high in RAM (usually just under its own main stack) and
+// manages the memory below it itself. The runtime must use exactly that range for malloc, never move it to the
+// first free RAM after the executable, where the title keeps its own data.
+#include <cstdint>
+
+namespace GuestHeapLayout
+{
+    constexpr uint32_t kDefaultEnd = 0x01FF0000u;
+
+    // Exclusive heap limit for an exact title heap, or 0 when the generic SetupHeap path applies.
+    constexpr uint32_t exactLimit(uint32_t alignedBase, uint32_t size, uint32_t mainStackBase, uint32_t ramSize)
+    {
+        if (size == 0u || size == 0xFFFFFFFFu || alignedBase == 0u || alignedBase >= ramSize)
+            return 0u;
+        const uint64_t end = static_cast<uint64_t>(alignedBase) + size;
+        if (end <= kDefaultEnd || end > ramSize)
+            return 0u;
+        uint32_t limit = static_cast<uint32_t>(end);
+        if (mainStackBase > alignedBase && mainStackBase < limit)
+            limit = mainStackBase;
+        return limit;
+    }
+}
