+bool PS2Runtime::configureExactGuestHeap(uint32_t guestBase, uint32_t guestLimit)
+{
+    const uint32_t base = alignGuestHeapValue(guestBase, kGuestHeapDefaultAlignment);
+    if (base == 0u || base >= guestLimit || guestLimit > PS2_RAM_SIZE)
+        return false;
+    std::lock_guard<std::mutex> lock(m_guestHeapMutex);
+    m_guestHeapBlocks.clear();
+    m_guestHeapBlocks.push_back({base, guestLimit - base, true});
+    m_guestHeapSuggestedBase = base;
+    m_guestHeapBase = base;
+    m_guestHeapEnd = base;
+    m_guestHeapLimit = guestLimit;
+    m_guestHeapConfigured = true;
+    return true;
+}
