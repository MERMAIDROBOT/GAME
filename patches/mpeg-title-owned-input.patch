+    // Source chain: a pending QWC from a previous tag transfers first, then tags follow.
+    uint32_t tadr = m_ioRegisters[channelBase + 0x30u] & 0xFFFFFFF0u;
+    if (qwc != 0u)
+    {
+        if (!deliver(madr, qwc))
+            throw std::runtime_error("IPU input DMA continuation outside memory");
