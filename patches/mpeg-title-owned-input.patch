+        }
+        const uint32_t bytes = qwc * 16u;
+        if (phys >= limit || bytes > limit - phys)
+            return false;
+        m_ipuInputSink(base + phys, bytes);
+        return true;
+    };
+
+    const uint32_t mode = (chcr >> 2u) & 0x3u;
+    uint32_t madr = m_ioRegisters[channelBase + 0x10u] & 0xFFFFFFF0u;
+    const uint32_t qwc = m_ioRegisters[channelBase + 0x20u] & 0xFFFFu;
+    if (mode == 0u)
+    {
