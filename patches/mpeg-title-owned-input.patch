+    }
+    uint32_t asp = (chcr >> 4u) & 3u;
+    uint32_t asr[2] = {m_ioRegisters[channelBase + 0x40u], m_ioRegisters[channelBase + 0x50u]};
+    bool finished = false;
+    const bool tie = (chcr & (1u << 7)) != 0u;
+    for (int tags = 0; tags < 65536; ++tags)
+    {
+        const bool scratch = isScratchpad(tadr) || (tadr & 0x80000000u) != 0u;
+        uint32_t phys = 0u;
+        try
+        {
+            phys = scratch ? (tadr & (PS2_SCRATCHPAD_SIZE - 1u)) : translateAddress(tadr & 0x7FFFFFFFu);
+        }
+        catch (...)
+        {
+            throw std::runtime_error("IPU input DMA tag outside memory");
+        }
+        const uint8_t *base = scratch ? m_scratchpad : m_rdram;
+        if (phys + 16u > (scratch ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE))
+            throw std::runtime_error("IPU input DMA truncated tag");
+        uint64_t tag = 0u;
+        std::memcpy(&tag, base + phys, sizeof(tag));
+        const uint32_t tagQwc = static_cast<uint32_t>(tag & 0xFFFFu);
+        const uint32_t id = static_cast<uint32_t>((tag >> 28u) & 0x7u);
+        const bool irq = ((tag >> 31u) & 1u) != 0u;
+        const uint32_t addr = static_cast<uint32_t>((tag >> 32u) & 0xFFFFFFF0u);
+        uint32_t data = 0u;
+        bool end = false;
+        switch (id)
+        {
+        case 0: data = addr; tadr += 16u; end = true; break;                 // refe
+        case 1: data = tadr + 16u; tadr = data + tagQwc * 16u; break;        // cnt
+        case 2: data = tadr + 16u; tadr = addr; break;                       // next
+        case 3: case 4: data = addr; tadr += 16u; break;                     // ref, refs
+        case 7: data = tadr + 16u; tadr = data + tagQwc * 16u; end = true; break; // end
+        case 5:
+            if (asp >= 2u) throw std::runtime_error("IPU DMA CALL stack overflow");
+            data = tadr + 16u; asr[asp++] = data + tagQwc * 16u; tadr = addr; break;
+        case 6:
+            data = tadr + 16u;
+            if (asp == 0u) { tadr = data + tagQwc * 16u; end = true; }
+            else tadr = asr[--asp];
+            break;
+        default: throw std::runtime_error("Invalid IPU DMA tag");
+        }
+        m_ioRegisters[channelBase] = (m_ioRegisters[channelBase] & 0xFFFFu) | static_cast<uint32_t>(tag & 0xFFFF0000u);
+        if (!deliver(data, tagQwc))
+            throw std::runtime_error("IPU input DMA chain payload outside memory");
+        madr = data + tagQwc * 16u;
+        if (end || (irq && tie)) { finished = true; break; }
+    }
+    if (!finished) throw std::runtime_error("IPU input DMA chain tag limit exceeded");
+    m_ioRegisters[channelBase] = (m_ioRegisters[channelBase] & ~0x30u) | (asp << 4u);
+    m_ioRegisters[channelBase + 0x40u] = asr[0];
+    m_ioRegisters[channelBase + 0x50u] = asr[1];
+    m_ioRegisters[channelBase + 0x10u] = madr;
+    m_ioRegisters[channelBase + 0x20u] = 0u;
+    m_ioRegisters[channelBase + 0x30u] = tadr;
+    completeDmacChannel(channelBase, 4u);
+    return true;
+}
