+" vec3 b=a*0.5+0.25*(texture(texture0,uv+dir*-0.5).rgb+texture(texture0,uv+dir*0.5).rgb);\n"
+" float lB=lum(b); finalColor=vec4((lB<lMin||lB>lMax)?a:b, 1.0); }\n";
