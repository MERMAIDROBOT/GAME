+"#version 330\n"
+"in vec2 fragTexCoord; in vec4 fragColor; out vec4 finalColor;\n"
+"uniform sampler2D texture0; uniform vec4 colDiffuse; uniform vec2 texSize; uniform vec4 srcRect; uniform float sharpness;\n"
