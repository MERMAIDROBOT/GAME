+        wait_=reinterpret_cast<Wait>(dlsym(module_,"hwgs_surface_wait"));
+        release_=reinterpret_cast<Release>(dlsym(module_,"hwgs_surface_release"));
+        if (!wait_ || !release_) {dlclose(module_);module_=nullptr;return false;}
+        return true;
+    }
