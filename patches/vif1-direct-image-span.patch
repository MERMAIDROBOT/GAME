+// A DIRECT/DIRECTHL payload goes to PATH2 as a byte stream: any GIF packet (PACKED, REGLIST or IMAGE) may span
+// several DIRECT commands, and the next DIRECT continues it without a new tag. Reassemble whole tag+payload units
+// before submitting them, so a continuation is never read as a fresh GIF tag.
+void PS2Memory::submitVif1DirectPayload(const uint8_t *data, uint32_t qwCount, bool directHl)
+{
+    if (m_vif1Path2Stream.empty())
+        m_vif1Path2Hl = directHl;
+    m_vif1Path2Stream.insert(m_vif1Path2Stream.end(), data, data + static_cast<size_t>(qwCount) * 16u);
+    size_t offset = 0u;
+    while (m_vif1Path2Stream.size() - offset >= 16u)
+    {
+        uint64_t tagLo = 0u;
+        std::memcpy(&tagLo, m_vif1Path2Stream.data() + offset, sizeof(tagLo));
+        const uint64_t nloop = tagLo & 0x7FFFu;
+        const uint32_t flg = static_cast<uint32_t>((tagLo >> 58) & 0x3u);
+        uint64_t nreg = (tagLo >> 60) & 0xFu;
+        if (nreg == 0u)
+            nreg = 16u;
+        uint64_t payload = 0u;
+        if (flg == 0u)
+            payload = nloop * nreg * 16u;
+        else if (flg == 1u)
+            payload = (nloop * nreg * 8u + 15u) & ~uint64_t(15u);
+        else
+            payload = nloop * 16u;
+        if (m_vif1Path2Stream.size() - offset < 16u + payload)
+            break;
+        submitGifPacket(GifPathId::Path2, m_vif1Path2Stream.data() + offset, static_cast<uint32_t>(16u + payload), true,
+                        m_vif1Path2Hl);
+        offset += static_cast<size_t>(16u + payload);
+    }
+    m_vif1Path2Stream.erase(m_vif1Path2Stream.begin(), m_vif1Path2Stream.begin() + static_cast<std::ptrdiff_t>(offset));
+    m_vif1PendingPath2ImageQwc = 0u;
+    if (m_vif1Path2Stream.empty())
+        m_vif1Path2Hl = false;
+    else
+        m_vif1Path2Hl = m_vif1Path2Hl || directHl;
+}
