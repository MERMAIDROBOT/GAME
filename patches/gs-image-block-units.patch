+        tc.Run("sceGsExecStoreImage uses vram_addr as block units and survives a title-owned heap", [](TestCase &t)
+        {
+            PS2Runtime runtime;
+            t.IsTrue(runtime.memory().initialize(), "runtime memory initialize should succeed");
+            uint8_t *const rdram = runtime.memory().getRDRAM();
+            constexpr uint32_t kImageAddr = 0x4000u;
+            constexpr uint32_t kSrcAddr = 0x5000u;
+            constexpr uint32_t kDstAddr = 0x6000u;
+            // libgraph: vram_addr is "word address / 64", the GS block number itself (a photo at 3000).
+            const GsImageMem image{0u, 0u, 2u, 2u, 3000u, 1u, 0u};
+            const uint8_t pixels[16] = {1u, 2u, 3u, 4u, 5u, 6u, 7u, 8u, 9u, 10u, 11u, 12u, 13u, 14u, 15u, 16u};
+            writeGsImageTest(rdram, kImageAddr, image);
+            std::memcpy(rdram + kSrcAddr, pixels, sizeof(pixels));
+
+            R5900Context loadCtx{};
+            setRegU32(loadCtx, 4, kImageAddr);
+            setRegU32(loadCtx, 5, kSrcAddr);
+            ps2_stubs::sceGsExecLoadImage(rdram, &loadCtx, &runtime);
+            uint64_t loadBitblt = 0u;
+            std::memcpy(&loadBitblt, rdram + runtime.guestHeapBase() + 16u, sizeof(loadBitblt));
+            t.Equals(static_cast<uint32_t>((loadBitblt >> 32) & 0x3FFFu), 3000u,
+                     "sceGsExecLoadImage DBP should be vram_addr unscaled");
+
+            // The title claims the whole heap (as Kelly Slater does at boot).
+            std::vector<uint32_t> claimed;
+            for (uint32_t size = 16u << 20; size >= 16u; size /= 2u)
+                while (const uint32_t a = runtime.guestMalloc(size, 16u))
+                    claimed.push_back(a);
+            t.Equals(runtime.guestMalloc(16u, 16u), 0u, "fixture should exhaust the guest heap");
+
+            R5900Context storeCtx{};
+            setRegU32(storeCtx, 4, kImageAddr);
+            setRegU32(storeCtx, 5, kDstAddr);
+            ps2_stubs::sceGsExecStoreImage(rdram, &storeCtx, &runtime);
+            t.Equals(static_cast<int32_t>(getRegU32Test(storeCtx, 2)), 0,
+                     "sceGsExecStoreImage should succeed without guest heap space");
+            t.IsTrue(std::memcmp(rdram + kDstAddr, pixels, sizeof(pixels)) == 0,
+                     "sceGsExecStoreImage should read back the image at block 3000, not block 0");
+
+            // Negative control: an image at block 0 holds different pixels, so a scaled SBP reading
+            // block 0 would not match.
+            const GsImageMem other{0u, 0u, 2u, 2u, 0u, 1u, 0u};
+            writeGsImageTest(rdram, kImageAddr, other);
+            std::memset(rdram + kDstAddr, 0, sizeof(pixels));
+            R5900Context otherCtx{};
+            setRegU32(otherCtx, 4, kImageAddr);
+            setRegU32(otherCtx, 5, kDstAddr);
+            ps2_stubs::sceGsExecStoreImage(rdram, &otherCtx, &runtime);
+            t.IsTrue(std::memcmp(rdram + kDstAddr, pixels, sizeof(pixels)) != 0,
+                     "block 0 should not hold the uploaded image");
+            for (const uint32_t a : claimed)
+                runtime.guestFree(a);
+        });
