+// SPDX-License-Identifier: GPL-3.0-only
+// Process-lifetime flags. Set environment before runtime startup. Cache opt-out
+// restores dynamic diagnostic lookup; correctness-path gates remain start-only.
+#pragma once
+#include <cstdlib>
+namespace ps2_port_env {
+inline bool enabled(const char *key) { const char *v=std::getenv(key); return !(v && v[0]=='0'); }
+inline bool cacheEnabled() { static const bool on=enabled("PS2_PORT_ENV_CACHE"); return on; }
+inline bool vuTrace() { static const bool on=std::getenv("PS2_PORT_VU_TRACE")!=nullptr; return cacheEnabled() ? on : std::getenv("PS2_PORT_VU_TRACE")!=nullptr; }
+inline bool vifFast() { static const bool on=enabled("PS2_PORT_VIF_FASTPATH"); return on; }
+inline bool lazyTimers() { static const bool on=enabled("PS2_PORT_LAZY_EE_TIMERS"); return on; }
+} // namespace ps2_port_env
