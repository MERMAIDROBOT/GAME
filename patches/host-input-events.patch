+// Event-ordered keyboard capture (v8).
+// The window thread samples input once per presented frame. When
+// presentation stalls (for example, 60-120 ms), several key transitions land
+// between samples and a level/press-queue sample cannot recover their order:
+// Left held, Circle down, both up before the next sample reached the game as
+// Circle alone. GLFW delivers every PRESS/RELEASE in order from inside
+// PollInputEvents on this same thread, so chain raylib's key callback and
+// record the full keyboard mask after each transition.
+extern "C" {
+    typedef struct GLFWwindow GLFWwindow;
+    typedef void (*GLFWkeyfun)(GLFWwindow *, int, int, int, int);
+    GLFWkeyfun glfwSetKeyCallback(GLFWwindow *, GLFWkeyfun);
+    GLFWwindow *glfwGetCurrentContext(void);
+#if defined(__APPLE__)
+    void *glfwGetCocoaWindow(GLFWwindow *);
+#endif
+}
+
+namespace
+{
+    constexpr int kKeyCount = 512; // raylib MAX_KEYBOARD_KEYS; raylib key codes are GLFW key codes
+    std::array<bool, kKeyCount> eventKeys{};
+    GLFWkeyfun previousKeyCallback = nullptr;
+    bool keyEventsInstalled = false;
+    std::array<uint16_t, 64> keyEvents{}; // positive (pressed=1) keyboard masks, in event order
+    size_t keyEventCount = 0;
+
+    uint16_t keyboardMaskFrom(const std::array<bool, kKeyCount> &k)
+    {
+        uint16_t m = 0;
+        if (k[KEY_UP]) m |= PAD_UP;
+        if (k[KEY_DOWN]) m |= PAD_DOWN;
+        if (k[KEY_LEFT]) m |= PAD_LEFT;
+        if (k[KEY_RIGHT]) m |= PAD_RIGHT;
+        if (k[KEY_X] || k[KEY_SPACE]) m |= PAD_CROSS;
+        if (k[KEY_C] || k[KEY_ESCAPE]) m |= PAD_CIRCLE;
+        if (k[KEY_Z] || k[KEY_KP_0]) m |= PAD_SQUARE;
+        if (k[KEY_V] || k[KEY_KP_1]) m |= PAD_TRIANGLE;
+        if (k[KEY_Q]) m |= PAD_L1;
+        if (k[KEY_E]) m |= PAD_R1;
+        if (k[KEY_LEFT_SHIFT]) m |= PAD_L2;
+        if (k[KEY_RIGHT_SHIFT]) m |= PAD_R2;
+        if (k[KEY_ENTER]) m |= PAD_START;
+        if (k[KEY_TAB]) m |= PAD_SELECT;
+        return m;
+    }
+
+    void onHostKey(GLFWwindow *window, int key, int scancode, int action, int mods)
+    {
+        // raylib keeps its own key state and press queue; it must see every event.
+        if (previousKeyCallback) previousKeyCallback(window, key, scancode, action, mods);
+        if (key <= 0 || key >= kKeyCount || action == 2 /* GLFW_REPEAT */) return;
+        const uint16_t before = keyboardMaskFrom(eventKeys);
+        eventKeys[key] = action == 1;
+        const uint16_t after = keyboardMaskFrom(eventKeys);
+        if (after == before) return;
+        if (keyEventCount < keyEvents.size()) keyEvents[keyEventCount++] = after;
+        else keyEvents.back() = after; // bounded; the latest state always survives
+    }
+
+    bool installHostKeyEvents()
+    {
+        if (keyEventsInstalled) return true;
+        static const bool disabled = [] {
+            const char *v = std::getenv("PS2_PORT_KEY_EVENTS");
+            return v && *v == '0';
+        }();
+        if (disabled) return false;
+        // GetWindowHandle returns NSWindow* on macOS, not GLFWwindow*.
+        // The native-window pointer must never be passed to a GLFW API.
+        GLFWwindow *handle = glfwGetCurrentContext();
+        if (!handle) return false;
+#if defined(__APPLE__)
+        if (glfwGetCocoaWindow(handle) != GetWindowHandle()) return false;
+#endif
+        for (int k = 1; k < kKeyCount; ++k) eventKeys[k] = IsKeyDown(k);
+        previousKeyCallback = glfwSetKeyCallback(handle, onHostKey);
+        keyEventsInstalled = true;
+        if (std::getenv("PS2_PORT_PAD_TRACE"))
+            std::cerr << "[port-lab host-pad] event-ordered keyboard capture installed" << std::endl;
+        return true;
+    }
 }
 
