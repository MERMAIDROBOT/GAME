-    if (sampleHostPad(state, sizeof(state),freshPresses)) publishPadState(state,freshPresses);
+    const bool sampledOk = sampleHostPad(state, sizeof(state),freshPresses);
+    // Scripted window-control runs keep the command path in publishPadState.
+    const char *control = std::getenv("PS2_PORT_PRIVATE_WINDOW_CONTROL");
+    const bool scripted = control && *control == '1' && std::getenv("PS2_PORT_PAD_COMMAND");
+    if (sampledOk) {
+        if (keyEventsInstalled && !IsGamepadAvailable(0) && !scripted) publishPadEvents(state);
+        else publishPadState(state,freshPresses);
+    }
+    keyEventCount = 0;
 }
 
