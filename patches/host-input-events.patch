 void ps2PortPublishPadState(const uint8_t* state){publishPadState(state,0);}
 
+// Publish each recorded keyboard transition as its own pad state, in order,
+// then the sampled state. Non-keyboard bits (mouse buttons) come from the
+// sample. queueEdge merges expanding press-only states and keeps every
+// release as a barrier, so Left, Left+Circle, Circle, none reaches the game
+// as Left+Circle, Circle, none.
+static void publishPadEvents(const uint8_t *state) {
+    std::lock_guard<std::mutex> lock(hostPadMutex);
+    const uint16_t sampled = uint16_t(~(state[2] | (state[3] << 8)));
+    const uint16_t otherBits = sampled & uint16_t(~keyboardMaskFrom(eventKeys));
+    uint16_t previous = uint16_t(~(hostPadState[2] | (hostPadState[3] << 8)));
+    std::array<uint8_t,32> edge;
+    std::memcpy(edge.data(), state, 32);
+    static const bool trace = std::getenv("PS2_PORT_PAD_TRACE") != nullptr;
+    auto emit = [&](uint16_t pressed) {
+        if (pressed == previous) return;
+        const uint16_t low = uint16_t(~pressed);
+        edge[2] = low & 255u; edge[3] = low >> 8;
+        // Ordered host events preserve each release state. In particular,
+        // releasing a direction while holding an action must reach the guest.
+        queueEdge(edge.data(), uint16_t(previous & ~pressed) == 0, false);
+        if (trace) {
+            static unsigned changes = 0;
+            if (changes++ < 512u) {
+                const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+                std::cerr << "[port-lab host-pad] ns=" << ns << " mask=" << pressed << " events=" << keyEventCount << std::endl;
+            }
+        }
+        previous = pressed;
+    };
+    for (size_t i = 0; i < keyEventCount; ++i) emit(uint16_t(keyEvents[i] | otherBits));
+    emit(sampled);
+    std::memcpy(hostPadState.data(), state, hostPadState.size());
+}
