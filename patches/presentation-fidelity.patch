diff --git a/ps2xRuntime/include/runtime/gs/gs_field_presentation.h b/ps2xRuntime/include/runtime/gs/gs_field_presentation.h
new file mode 100644
index 0000000..1e777d9
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_field_presentation.h
@@ -0,0 +1,18 @@
+#pragma once
+
+#include <cstdint>
+
+// Which frame-buffer line the host shows on output line y of an interlaced display (SMODE2.INT=1).
+//  FFMD=1 (frame mode): every field scans the same half-height buffer, so each buffer line covers two
+//                       output lines.
+//  FFMD=0 (field mode): the buffer holds both fields' lines and the CRT shows them interleaved, so every
+//                       line is shown (weave). Showing only the current field's lines, doubled, halves the
+//                       vertical detail and moves the picture by a line every field.
+namespace GSFieldPresentation
+{
+    inline uint32_t sourceLine(uint32_t y, uint32_t height, bool frameMode)
+    {
+        const uint32_t line = frameMode ? (y >> 1u) : y;
+        return line < height ? line : (height ? height - 1u : 0u);
+    }
+}
