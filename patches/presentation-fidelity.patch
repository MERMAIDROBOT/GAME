@@ -441,14 +442,19 @@ namespace
 
     void applyFieldPresentation(std::vector<uint8_t> &pixels, uint32_t width, uint32_t height, bool oddField, bool frameMode)
     {
-        if (pixels.empty() || width == 0u || height < 2u)
-            return;
+        static int lastMode = -1;
+        if (lastMode != static_cast<int>(frameMode))
+        {
+            lastMode = static_cast<int>(frameMode);
+            std::fprintf(stderr, "[gs] interlaced display, FFMD=%d (%s)\n", lastMode, frameMode ? "frame: line-doubled" : "field: weave");
+        }
+        (void)oddField;
+        if (pixels.empty() || width == 0u || height < 2u || !frameMode)
+            return; // Field mode: the buffer already holds both fields' lines.
         const std::vector<uint8_t> source = pixels;
         for (uint32_t y = 0; y < height; ++y)
         {
-            uint32_t sourceY = frameMode ? (y >> 1u) : (((y >> 1u) << 1u) + (oddField ? 1u : 0u));
-            if (sourceY >= height)
-                sourceY = height - 1u;
+            const uint32_t sourceY = GSFieldPresentation::sourceLine(y, height, frameMode);
             std::memcpy(pixels.data() + y * kHostFrameWidth * 4u,
                         source.data() + sourceY * kHostFrameWidth * 4u,
                         width * 4u);
