+    RpcResult IopSubsystem::handleLoadfileRpc(const RpcRequest &request)
+    {
+        RpcResult result;
+        result.handled = true;
+        result.resultAddress = request.receive.address;
+        auto reply = [&](const void *data, size_t size) {
+            if (request.receive.address && request.receive.size)
+                (void)m_impl->host.writeGuest(request.receive.address, data, std::min<size_t>(size, request.receive.size));
+        };
+        auto sendWord = [&](size_t offset) -> uint32_t {
+            uint32_t value = 0u;
+            if (request.send.address && request.send.size >= offset + 4u)
+                (void)m_impl->host.readGuest(request.send.address + static_cast<uint32_t>(offset), &value, 4u);
+            return value;
+        };
+        switch (request.function)
+        {
+        case kLoadfileVersion:
+        {
+            const char version[4] = {'2', '7', '1', '0'};
+            reply(version, sizeof(version));
+            break;
+        }
+        case kLoadfileSearchName:
+        {
+            std::array<char, 0x100> name{};
+            if (request.send.address && request.send.size > 8u)
+                (void)m_impl->host.readGuest(request.send.address + 8u, name.data(),
+                                             std::min<size_t>(name.size() - 1u, request.send.size - 8u));
+            name.back() = '\0';
+            int32_t id = m_impl->emulator.findResidentModuleByName(name.data());
+            if (id < 0)
+                id = kKeUnknownModule;
+            reply(&id, sizeof(id));
+            break;
+        }
+        case kLoadfileSearchAddress:
+        {
+            int32_t id = m_impl->emulator.findResidentModuleByAddress(sendWord(0));
+            if (id < 0)
+                id = kKeUnknownModule;
+            reply(&id, sizeof(id));
+            break;
+        }
+        case kLoadfileStop:
+        {
+            const int32_t id = static_cast<int32_t>(sendWord(0));
+            int32_t status = 0;
+            const int32_t words[2] = {m_impl->emulator.stopModule(id, &status) ? id : kKeUnknownModule, 1};
+            reply(words, sizeof(words));
+            break;
+        }
+        default:
+        {
+            const int32_t unsupported = -1;
+            reply(&unsupported, sizeof(unsupported));
+            break;
+        }
+        }
+        return result;
+    }
