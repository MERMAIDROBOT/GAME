+    m_path3MaskedFifo.clear();
+    if (packetEnd == 0u || packetEnd >= queued.size())
+    {
+        // No complete packet boundary inside the queue: the open packet completes.
+        m_path3MaskedFifo.push_back(std::move(queued));
+        flushMaskedPath3Packets();
+        return;
+    }
