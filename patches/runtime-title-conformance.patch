+        uint64_t dataQw = nloop;
+        if (flg == 0u)
+            dataQw = nloop * nreg;
+        else if (flg == 1u)
+            dataQw = (nloop * nreg + 1u) / 2u;
+        offset += 16u + static_cast<size_t>(dataQw) * 16u;
+        if (eop)
+        {
+            packetEnd = offset;
+            break;
+        }
+    }
