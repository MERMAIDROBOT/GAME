+    std::vector<uint8_t> queued;
+    for (const auto &chunk : m_path3MaskedFifo)
+        queued.insert(queued.end(), chunk.begin(), chunk.end());
+
+    // Walk GIF tags up to and including the first one with EOP.
+    size_t offset = 0;
+    size_t packetEnd = 0;
+    while (offset + 16u <= queued.size())
+    {
+        uint64_t tag = 0;
+        std::memcpy(&tag, queued.data() + offset, sizeof(tag));
+        const uint64_t nloop = tag & 0x7FFFu;
+        const bool eop = (tag & 0x8000u) != 0u;
+        const uint32_t flg = static_cast<uint32_t>((tag >> 58) & 0x3u);
+        uint64_t nreg = (tag >> 60) & 0xFu;
+        if (nreg == 0u)
