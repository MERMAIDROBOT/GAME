+        {
+            if (packetSize < 24u)
+                return false;
+            uint32_t reg = 0u, value = 0u;
+            std::memcpy(&reg, packet + 16u, 4u);
+            std::memcpy(&value, packet + 20u, 4u);
+            m_sregs[reg] = value;
+            return true;
+        }
+        auto it = m_cmdHandlers.find(commandId);
+        if (it == m_cmdHandlers.end())
+            it = m_cmdHandlers.find(commandId & 0x7fffffffu);
+        if (it == m_cmdHandlers.end() || it->second.function == 0u || packetAddress == 0u)
+            return false;
+        (void)executor.executeGuestFunction(it->second.function, packetAddress, it->second.data, 0u, 0u, it->second.gp);
+        return true;
+    }
