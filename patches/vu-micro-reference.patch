+namespace vu_reference
+{
+    inline uint32_t bitsOf(float value)
+    {
+        uint32_t bits;
+        std::memcpy(&bits, &value, sizeof(bits));
+        return bits;
+    }
+
+    // The PS2 result and flags of FMAC lane `c` of `upper` (macro and micro encodings share the
+    // numbering; the special table holds the ACC forms), from the raw register bits: exponent 255 is
+    // a number, overflow clamps to +-max, a multiply-add rounds the product first and reports the
+    // flags of the final add (ps2_vu_float.h, the same arithmetic as VU0 macro mode).
+    inline bool fmacLane(uint32_t upper, const VU1State &s, uint32_t c, ps2_vu_float::Lane &out)
+    {
+        using ps2_vu_float::Op;
+        const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+        const bool special = op >= 0x3Cu;
+        const uint8_t code = special ? static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu)) : op;
+        const uint8_t fs = (upper >> 11) & 31u, ft = (upper >> 16) & 31u;
+        const auto vs = [&](uint32_t lane) { return bitsOf(s.vf[fs][lane]); };
+        const auto vt = [&](uint32_t lane) { return bitsOf(s.vf[ft][lane]); };
+        const uint32_t acc = bitsOf(s.acc[c]), q = bitsOf(s.q), i = bitsOf(s.i);
+        const auto lane = [&](Op o, uint32_t a, uint32_t b) { out = ps2_vu_float::lane(o, a, b, acc); return true; };
+        static constexpr uint8_t left[4] = {1u, 2u, 0u, 3u};
+        static constexpr uint8_t right[4] = {2u, 0u, 1u, 3u};
+        if (code <= 0x0Fu || (code >= 0x18u && code <= 0x1Bu))
+        {
+            static constexpr Op group[] = {Op::Add, Op::Sub, Op::Madd, Op::Msub, Op::Max, Op::Mini, Op::Mul};
+            return lane(group[code >> 2], vs(c), vt(code & 3u));
+        }
+        switch (code)
+        {
+        case 0x1Cu: return lane(Op::Mul, vs(c), q);
+        case 0x1Eu: return lane(Op::Mul, vs(c), i);
+        case 0x20u: return lane(Op::Add, vs(c), q);
+        case 0x21u: return lane(Op::Madd, vs(c), q);
+        case 0x22u: return lane(Op::Add, vs(c), i);
+        case 0x23u: return lane(Op::Madd, vs(c), i);
+        case 0x24u: return lane(Op::Sub, vs(c), q);
+        case 0x25u: return lane(Op::Msub, vs(c), q);
+        case 0x26u: return lane(Op::Sub, vs(c), i);
+        case 0x27u: return lane(Op::Msub, vs(c), i);
+        case 0x28u: return lane(Op::Add, vs(c), vt(c));
+        case 0x29u: return lane(Op::Madd, vs(c), vt(c));
+        case 0x2Au: return lane(Op::Mul, vs(c), vt(c));
+        case 0x2Cu: return lane(Op::Sub, vs(c), vt(c));
+        case 0x2Du: return lane(Op::Msub, vs(c), vt(c));
+        case 0x2Eu:  // OPMSUB (upper table) / OPMULA (special table)
+            return lane(special ? Op::Mul : Op::Msub, vs(left[c]), vt(right[c]));
+        default:
