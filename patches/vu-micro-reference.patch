+        }
+    }
+
+    // VU1's elementary function unit in exact PS2 arithmetic (ps2float: truncating, no infinities).
+    // ERCPR, ESQRT, ERSQRT, ESUM, ESADD, ERSADD, ELENG and ERLENG reproduce every result of the
+    // ps2autotests hardware run (tests/vu/lower/efu.expected). EATAN* use t = (x - 1) / (x + 1), the
+    // documented odd series (fourth coefficient -0.139085337519646) and pi/4 = 0x3F490FDA; ESIN the odd
+    // series; EEXP 1 / (1 + series)^4. Those are the closest known forms (36/48, 7/16 and 10/16
+    // bit-exact against that run, the rest within a few last-bit steps); the unit's internal precision
+    // is not public.
+    namespace efu
+    {
+        constexpr uint32_t kOne = 0x3F800000u, kPiOver4 = 0x3F490FDAu;
+        constexpr uint32_t kAtan[] = {0x3f7ffff5u, 0xbeaaa61cu, 0x3e4c40a6u, 0xbe0e6c63u,
+                                      0x3dc577dfu, 0xbd6501c4u, 0x3cb31652u, 0xbb84d7e7u};
+        constexpr uint32_t kSin[] = {0x3f800000u, 0xbe2aaaa4u, 0x3c08873eu, 0xb94fb21fu, 0x362e9c14u};
+        constexpr uint32_t kExp[] = {0x3e7fffa8u, 0x3d0007f4u, 0x3b29d3ffu, 0x3933e553u, 0x36b63510u, 0x353961acu};
+        inline float f(uint32_t bits)
+        {
+            float value;
+            std::memcpy(&value, &bits, sizeof(value));
+            return value;
+        }
+        inline uint32_t add(uint32_t a, uint32_t b) { return ps2f_raw(ps2f_add(a, b)); }
+        inline uint32_t sub(uint32_t a, uint32_t b) { return ps2f_raw(ps2f_sub(a, b)); }
+        inline uint32_t mul(uint32_t a, uint32_t b) { return ps2f_raw(ps2f_mul(a, b)); }
+        inline uint32_t div(uint32_t a, uint32_t b) { return ps2f_raw(ps2f_div(a, b)); }
+        inline uint32_t sqrt(uint32_t a) { return ps2f_raw(ps2f_sqrt(a)); }
+        inline uint32_t rsqrt(uint32_t a, uint32_t b) { return ps2f_raw(ps2f_rsqrt(a, b)); }
+        inline uint32_t sumSquares(const float *v)
+        {
+            const uint32_t x = bitsOf(v[0]), y = bitsOf(v[1]), z = bitsOf(v[2]);
+            return add(add(mul(x, x), mul(y, y)), mul(z, z));
+        }
+        inline uint32_t sum(const float *v) { return add(add(add(bitsOf(v[0]), bitsOf(v[1])), bitsOf(v[2])), bitsOf(v[3])); }
+        inline uint32_t atan(uint32_t x)
+        {
+            const uint32_t t = div(sub(x, kOne), add(x, kOne)), t2 = mul(t, t);
+            uint32_t power = t, acc = 0u;
+            for (const uint32_t c : kAtan)
+            {
+                acc = add(acc, mul(c, power));
+                power = mul(power, t2);
+            }
+            return add(acc, kPiOver4);
+        }
+        inline uint32_t sin(uint32_t x)
+        {
+            const uint32_t x2 = mul(x, x);
+            uint32_t power = x, acc = 0u;
+            for (const uint32_t c : kSin)
+            {
+                acc = add(acc, mul(c, power));
+                power = mul(power, x2);
+            }
+            return acc;
+        }
+        inline uint32_t exp(uint32_t x)
+        {
+            uint32_t power = x, acc = 0u;
+            for (const uint32_t c : kExp)
+            {
+                acc = add(acc, mul(c, power));
+                power = mul(power, x);
+            }
+            acc = add(acc, kOne);
+            const uint32_t squared = mul(acc, acc);
+            return div(kOne, mul(squared, squared));
+        }
+    }
+}
