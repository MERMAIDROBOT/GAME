+// PS2 Port Lab: F12 saves the picture about to be presented. Raylib's own F12 writes into the working directory,
+// which is "/" for an app started from Finder (it only logs a failure); this goes to the user's Pictures folder.
+// PS2_PORT_SCREENSHOT_AT=<seconds> requests one that long after start, for tests without a keyboard.
+static void ps2PortSaveScreenshot()
+{
+    static unsigned serial = 0;
+    const char *home = std::getenv("HOME");
+    std::error_code error;
+    const std::filesystem::path folder = std::filesystem::path(home && *home ? home : "/tmp") / "Pictures" / "PS2 Port Lab Screenshots";
+    std::filesystem::create_directories(folder, error);
+    const std::time_t now = std::time(nullptr);
+    char stamp[32] = "";
+    std::tm local{};
+    localtime_r(&now, &local);
+    std::strftime(stamp, sizeof stamp, "%Y%m%d-%H%M%S", &local);
+    char name[64];
+    std::snprintf(name, sizeof name, "screenshot-%s-%02u.png", stamp, serial++ % 100u);
+    const std::string path = (folder / name).string();
+    rlDrawRenderBatchActive();          // the frame's queued draws reach the back buffer only at EndDrawing otherwise
+    Image picture = LoadImageFromScreen();
+    const bool saved = picture.data && ExportImage(picture, path.c_str());
+    if (picture.data) UnloadImage(picture);
+    std::cerr << (saved ? "[port-lab screenshot] saved " : "[port-lab screenshot] could not save ") << path << std::endl;
+}
 
