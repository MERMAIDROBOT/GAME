+void PS2Runtime::vu0Concurrent(R5900Context *ctx, int mode)
+{
+    if (!ctx->vu0_concurrent)
+        return;
+    uint8_t *const vu0Code = m_memory.getVU0Code();
+    uint8_t *const vu0Data = m_memory.getVU0Data();
+    if (!vu0Code || !vu0Data || !m_vu0.running())
+    {
+        ctx->vu0_concurrent = 0u;
+        return;
+    }
+    VU1State &state = m_vu0.state();
+    if (mode == 1)
+    {
+        // The EE's register file mirrors the program's since the last read; pass on what the EE wrote.
+        for (uint32_t i = 1; i < 32u; ++i)
+            _mm_storeu_ps(state.vf[i], ctx->vu0_vf[i]);
+        for (uint32_t i = 1; i < 16u; ++i)
+            state.vi[i] = static_cast<int16_t>(ctx->vi[i]);
+        state.q = ctx->vu0_q;
+        state.i = ctx->vu0_i;
+        return;
+    }
+    if (mode == 2)
+        finishVuProgram(m_vu0, vu0Code, PS2_VU0_CODE_SIZE, vu0Data, PS2_VU0_DATA_SIZE, m_gs, &m_memory, 4096, "VU0");
+    else
+        m_vu0.resume(vu0Code, PS2_VU0_CODE_SIZE, vu0Data, PS2_VU0_DATA_SIZE, m_gs, &m_memory,
+                     state.top, state.itop, 4096);
+    copyVu0StateToContext(state, ctx);
+    ctx->vu0_concurrent = m_vu0.running() ? 1u : 0u;
+}
