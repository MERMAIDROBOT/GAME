diff --git a/ps2xRuntime/include/runtime/gs/gs_host_rounding.h b/ps2xRuntime/include/runtime/gs/gs_host_rounding.h
new file mode 100644
index 0000000..22d036d
--- /dev/null
+++ b/ps2xRuntime/include/runtime/gs/gs_host_rounding.h
@@ -0,0 +1,28 @@
+#pragma once
+
+#include <cfenv>
+
+// The GS rasterizes with host float arithmetic written for round-to-nearest. Callers may arrive
+// with another mode active: a VU program runs under round-toward-zero and sends PATH1 packets
+// through XGKICK while it is still running. Without this guard, the same GS packet drew
+// differently depending on which path delivered it. Each GS entry point forces round-to-nearest
+// for its duration and restores the caller's mode on every exit.
+class GSHostRounding
+{
+public:
+    GSHostRounding() : m_previous(std::fegetround())
+    {
+        if (m_previous != FE_TONEAREST)
+            std::fesetround(FE_TONEAREST);
+    }
+    ~GSHostRounding()
+    {
+        if (m_previous != FE_TONEAREST)
+            std::fesetround(m_previous);
+    }
+    GSHostRounding(const GSHostRounding &) = delete;
+    GSHostRounding &operator=(const GSHostRounding &) = delete;
+
+private:
+    int m_previous;
+};
