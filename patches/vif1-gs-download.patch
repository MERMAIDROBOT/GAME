+uint32_t GS::consumeLocalToHostQwords(uint8_t *dst, uint32_t maxQwords)
+{
+    std::lock_guard<std::recursive_mutex> lock(m_stateMutex);
+    if (!m_backend)
+        return 0u;
+    const size_t pending = m_backend->GetTransferSnapshot().localToHostPendingBytes;
+    const auto qwords = static_cast<uint32_t>(std::min<size_t>(pending / 16u, maxQwords));
+    return qwords ? m_backend->ConsumeLocalToHostBytes(dst, qwords * 16u) / 16u : 0u;
+}
