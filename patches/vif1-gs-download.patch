+void PS2Memory::processVif1Download()
+{
+    const auto dctrl = m_ioRegisters.find(0x1000E000u);
+    if ((dctrl != m_ioRegisters.end() && !(dctrl->second & 1u)) ||
+        !(vif1_regs.stat & kVif1Fdr) || !(gs_regs.busdir & 1u) || !m_vif1DownloadSource)
+        return;
+
+    // The setup GIF packet may still be queued when the EE starts the download.
+    if (m_gifArbiter)
+        m_gifArbiter->drain();
+
+    auto &madr = m_ioRegisters[kVif1Channel + 0x10u];
+    auto &qwc = m_ioRegisters[kVif1Channel + 0x20u];
+    qwc &= 0xFFFFu;
+    if (qwc != 0u)
+    {
+        const uint32_t address = madr & ~0xFu;
+        const bool scratch = isScratchpad(address) || (address & 0x80000000u);
+        const uint32_t capacity = scratch ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+        const uint32_t offset = scratch ? address & (PS2_SCRATCHPAD_SIZE - 1u) : translateAddress(address);
+        uint8_t *const dst = scratch ? m_scratchpad : m_rdram;
+        if (!dst || offset >= capacity || qwc > (capacity - offset) / 16u)
+            return;
+
+        const uint32_t copied = m_vif1DownloadSource->consumeLocalToHostQwords(dst + offset, qwc);
+        if (copied != 0u)
+        {
+            if (!scratch)
+                markModified(offset, copied * 16u);
+            madr = address + copied * 16u;
+            qwc -= copied;
+        }
+    }
+    if (qwc == 0u)
+        completeDmacChannel(kVif1Channel, 1u);
+}
