+struct Vu1FlagRecord
+{
+    static constexpr uint32_t kMac = 1u;
+    static constexpr uint32_t kStatus = 2u;
+    static constexpr uint32_t kSticky = 4u;
+    static constexpr uint32_t kClip = 8u;
+
+    uint64_t ready;
+    uint32_t mac;
+    uint32_t status;
+    uint32_t extra;
+    uint32_t clip;
+    uint32_t writes;
+};
+
