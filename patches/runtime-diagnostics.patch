+VU1_FORCE_INLINE int32_t VU1Interpreter::readBranchVi(uint8_t reg) const
+{
+    if (reg == 0u)
+        return 0;
+    if (m_viBranchBackupValid &&
+        m_viBranchBackupReg == reg)
+    {
+        return m_viBranchBackupValue;
+    }
+    return m_state.vi[reg];
+}
