+VU1_FORCE_INLINE void VU1Interpreter::recordViWriteForBranch(uint8_t reg, int32_t oldValue)
+{
+    if (reg == 0u)
+        return;
+    m_viBranchBackupValue = oldValue;
+    m_viBranchBackupReg = reg;
+    m_viBranchBackupValid = true;
+}
