+            entry.readyCycle = record.ready;
+            entry.issueCycle = record.ready - VU1Interpreter::kFmacLatency;
+            entry.mac = record.mac;
+            entry.status = record.status;
+            entry.extraSticky = record.extra;
+            entry.clip = record.clip;
