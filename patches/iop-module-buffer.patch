-int main(){return testBlockingRpcServer();}
+namespace
+{
+    // sceSifLoadModuleBuffer passes an IOP address: the title SIF-DMAs the IRX into IOP RAM first.
+    int testModuleBufferFromIopRam()
+    {
+        TestHost host(0x20000u);
+        IopSubsystem iop(host);
+        constexpr uint32_t sid = 0xB10C0003u;
+        constexpr uint32_t iopImage = 0x00100000u;
+        writeBlockingRpcServerIrx(host, 0x100u, sid);
+        if (!expect(iop.writeMemory(iopImage, host.guest.data() + 0x100u, 0x8000u), "IOP RAM write failed")) return 1;
+        std::memset(host.guest.data() + 0x100u, 0, 0x8000u);       // nothing left in EE memory
+        const ModuleLoadResult module = iop.loadModuleBuffer(iopImage);
+        if (!expect(module.handled && module.moduleId > 0 && module.startResult == 0, "IRX in IOP RAM did not load")) return 1;
+        if (!expect(iop.canBindRpc(sid), "IRX loaded from IOP RAM did not register its server")) return 1;
+        return 0;
+    }
+}
+
+int main(){return testBlockingRpcServer() || testModuleBufferFromIopRam();}
