+void require(bool ok,const char *message){if(!ok)throw std::runtime_error(message);}
+int main(){try{
+ IopMemory memory;require(memory.zeroRam(0x100,0x104),"fixture RAM registration failed");IopKernel kernel(memory);IopCpuState cpu{};
+ auto set=[&](uint64_t delay,uint32_t arg,uint64_t now,unsigned ordinal=35){
+  memory.write32(0x100,static_cast<uint32_t>(delay));memory.write32(0x104,static_cast<uint32_t>(delay>>32));
+  cpu.gpr[4]=0x100;cpu.gpr[5]=0x200;cpu.gpr[6]=arg;cpu.gpr[28]=0x9988;
+  require(kernel.dispatchThreadImport(ordinal,cpu,now),"SetAlarm not handled");require(cpu.gpr[2]==0,"SetAlarm failed");};
+ auto cancel=[&](uint32_t arg,unsigned ordinal=37){cpu.gpr[4]=0x200;cpu.gpr[5]=arg;require(kernel.dispatchThreadImport(ordinal,cpu,0),"CancelAlarm not handled");return static_cast<int32_t>(cpu.gpr[2]);};
+ set(100,0xabc,10);require(!kernel.takeDueAlarm(109),"alarm fired early");
+ auto alarm=kernel.takeDueAlarm(110);require(alarm && alarm->argument==0xabc && alarm->gp==0x9988,"callback args/GP lost");
+ require(!kernel.takeDueAlarm(1000),"alarm reentered while callback running");kernel.completeAlarm(alarm->id,0,115);require(kernel.nextAlarmCycle(1000)==1000,"one-shot retained");
+ set(20,1,100,36);alarm=kernel.takeDueAlarm(120);require(bool(alarm),"iSetAlarm missing");kernel.completeAlarm(alarm->id,30,125);require(!kernel.takeDueAlarm(154),"repeat fired early");require(bool(kernel.takeDueAlarm(155)),"return period ignored");require(cancel(1,38)==0,"iCancelAlarm failed");kernel.completeAlarm(alarm->id,30,160);require(!kernel.takeDueAlarm(1000),"cancelled callback rearmed");
+ set(5,1,0);set(5,2,0);require(cancel(2)==0,"argument cancellation failed");alarm=kernel.takeDueAlarm(5);require(alarm && alarm->argument==1,"wrong argument cancelled");require(cancel(3)==-105,"missing cancel result");
+ kernel.reset();set(10,4,0);kernel.completeAlarm(alarm->id,1,0);require(!kernel.takeDueAlarm(9),"stale callback rearmed after reset");alarm=kernel.takeDueAlarm(10);require(alarm && alarm->argument==4,"reset lost new alarm");kernel.completeAlarm(alarm->id,0,10);
+ set(uint64_t(1)<<32,5,7);require(!kernel.takeDueAlarm((uint64_t(1)<<32)+6),"64-bit delay truncated");require(bool(kernel.takeDueAlarm((uint64_t(1)<<32)+7)),"64-bit delay missing");kernel.reset();
+ set(0,6,100);require(!kernel.takeDueAlarm(100),"zero delay recursive dispatch");require(bool(kernel.takeDueAlarm(101)),"zero delay never fired");
+ std::cout<<"Alarm deadline/repeat/cancel/argument/GP/reset/64-bit/zero-delay checks PASS\n";return 0;
+}catch(const std::exception &e){std::cerr<<e.what()<<'\n';return 1;}}
diff --git a/ps2xIOP/tests/private_alarm_rpc_test.cpp b/ps2xIOP/tests/private_alarm_rpc_test.cpp
