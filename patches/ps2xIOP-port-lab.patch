@@ -0,0 +1,29 @@
+#define main component_main
+#include "autodma_component_test.cpp"
+#undef main
+int main(){
+ IopSpu2 s;configure(s,1);std::vector<int16_t> out;s.setAudioSink([&](auto p){out.insert(out.end(),p.begin(),p.end());});
+ constexpr unsigned transfers=100,framesPerTransfer=1024;unsigned submitted=1,completed=0;auto b=pattern(4,1000);s.dmaWrite(1,b.data(),b.size(),0);
+ check(s.autoDmaBytesAccepted(1)==1024,"only one staging block accepted atstart");
+ check(!s.takeAutoDmaCompletion(1),"multi-block completion is deferred");
+ uint64_t firstCompletion=0;
+ for(uint64_t frame=1;frame<=transfers*framesPerTransfer;frame++){
+  s.advanceTo(frame*768);
+  if(s.takeAutoDmaCompletion(1)){
+   ++completed;if(!firstCompletion)firstCompletion=frame;
+   check(!s.takeAutoDmaCompletion(1),"completion consumed exactlyonce");
+   if(submitted<transfers){b=pattern(4,1000+submitted*10);s.dmaWrite(1,b.data(),b.size(),frame*768);++submitted;}
+  }
+ }
+ s.flushAudio();check(firstCompletion==513,"staging policy completes after finalblock accepted with oldaudio queued");
+ check(completed==transfers,"100 chained transfers eachcompleteonce");
+ check(out.size()==transfers*framesPerTransfer*2,"chained output retains exactsamplecount");
+ bool correct=out.size()==transfers*framesPerTransfer*2;
+ for(unsigned frame=0;frame<transfers*framesPerTransfer && correct;frame++){
+  int value=1000+(frame/framesPerTransfer)*10+frame%framesPerTransfer;
+  correct &= std::abs(int(out[frame*2])-value)<=3 && std::abs(int(out[frame*2+1])+value)<=3;
+ }
+ check(correct,"100 transfers seamless: no gaps, repeats, overwrites orchannelswap");
+ reg(s,0x5b0,0,transfers*framesPerTransfer*768ull);check(!s.takeAutoDmaCompletion(1),"disable leaves no stalecompletion");
+ std::printf("failures=%d\n",fails);return fails?1:0;
+}
