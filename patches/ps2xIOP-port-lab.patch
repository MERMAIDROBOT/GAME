+        // PS2_PORT_ENHANCE_IOP_BATCH=N (IOP cycles) runs the IOP once at least N cycles are owed.
+        static const int64_t batchEe = [] {
+            const char *v = std::getenv("PS2_PORT_ENHANCE_IOP_BATCH");
+            const long long n = v ? std::atoll(v) : 0;
+            return static_cast<int64_t>(n > 1 ? n * 8 : 8);
+        }();
+        if (m_impl->eeCycleCarry >= batchEe) {
+            m_impl->runCycles(static_cast<uint64_t>(m_impl->eeCycleCarry)/8u);
+            m_impl->eeCycleCarry -= static_cast<int64_t>((m_impl->totalCycles-m_impl->eeSyncCycle)*8u);
+            m_impl->eeSyncCycle = m_impl->totalCycles;
+        }
     }
 
