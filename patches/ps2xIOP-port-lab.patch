+    void writeBlockingRpcServerIrx(TestHost &host, uint32_t address, uint32_t sid)
+    {
+        constexpr uint32_t codeOffset = 0x100u;
+        constexpr uint32_t loadAddress = 0x00010000u;
+        constexpr uint32_t helperThread = loadAddress + 0x200u;
+        constexpr uint32_t serverFunction = loadAddress + 0x300u;
+        constexpr uint32_t serverBuffer = loadAddress + 0x400u;
+        constexpr uint32_t thbaseTable = loadAddress + 0x500u;
+        constexpr uint32_t thsemapTable = loadAddress + 0x540u;
+        constexpr uint32_t sifcmdTable = loadAddress + 0x580u;
+        constexpr uint32_t semaSlot = 0x600u;
+        constexpr uint32_t markerSlot = 0x604u;
+        constexpr uint32_t serverData = loadAddress + 0x640u;
+        constexpr uint32_t queueData = loadAddress + 0x6C0u;
+        constexpr uint32_t createThreadStub = thbaseTable + 20u;
+        constexpr uint32_t startThreadStub = createThreadStub + 8u;
+        constexpr uint32_t delayThreadStub = startThreadStub + 8u;
+        constexpr uint32_t createSemaStub = thsemapTable + 20u;
+        constexpr uint32_t signalSemaStub = createSemaStub + 8u;
+        constexpr uint32_t waitSemaStub = signalSemaStub + 8u;
+        constexpr uint32_t registerRpcStub = sifcmdTable + 20u;
+
+        constexpr uint32_t zero = 0u, at = 1u, v0 = 2u, a0 = 4u, a1 = 5u, a2 = 6u, a3 = 7u, t0 = 8u, sp = 29u, ra = 31u;
+        const auto itype = [](uint32_t op, uint32_t rs, uint32_t rt, uint32_t imm)
+        { return (op << 26u) | (rs << 21u) | (rt << 16u) | (imm & 0xFFFFu); };
+        const auto addiu = [&](uint32_t rt, uint32_t rs, uint32_t imm) { return itype(0x09u, rs, rt, imm); };
+        const auto ori = [&](uint32_t rt, uint32_t rs, uint32_t imm) { return itype(0x0Du, rs, rt, imm); };
+        const auto lui = [&](uint32_t rt, uint32_t imm) { return itype(0x0Fu, 0u, rt, imm); };
+        const auto lw = [&](uint32_t rt, uint32_t base, uint32_t offset) { return itype(0x23u, base, rt, offset); };
+        const auto sw = [&](uint32_t rt, uint32_t base, uint32_t offset) { return itype(0x2Bu, base, rt, offset); };
+        const auto jal = [](uint32_t target) { return 0x0C000000u | ((target >> 2u) & 0x03FFFFFFu); };
+        const auto move = [](uint32_t rd, uint32_t rs) { return (rs << 21u) | (rd << 11u) | 0x21u; };
+        constexpr uint32_t jrRa = 0x03E00008u;
+        constexpr uint32_t nop = 0u;
+
+        const std::vector<uint32_t> entry = {
+            addiu(sp, sp, 0xFFC0u), sw(ra, sp, 0x3Cu),
+            sw(zero, sp, 0x10u), sw(zero, sp, 0x14u), sw(zero, sp, 0x18u), addiu(t0, zero, 1u), sw(t0, sp, 0x1Cu),
+            addiu(a0, sp, 0x10u), jal(createSemaStub), nop,
+            lui(at, 1u), sw(v0, at, semaSlot),
+            sw(zero, sp, 0x10u), sw(zero, sp, 0x14u), lui(t0, 1u), ori(t0, t0, helperThread & 0xFFFFu), sw(t0, sp, 0x18u),
+            addiu(t0, zero, 0x800u), sw(t0, sp, 0x1Cu), addiu(t0, zero, 0x20u), sw(t0, sp, 0x20u),
+            addiu(a0, sp, 0x10u), jal(createThreadStub), nop,
+            move(a0, v0), jal(startThreadStub), move(a1, zero),
+            lui(a0, 1u), ori(a0, a0, serverData & 0xFFFFu),
+            lui(a1, sid >> 16u), ori(a1, a1, sid & 0xFFFFu),
+            lui(a2, 1u), ori(a2, a2, serverFunction & 0xFFFFu),
+            lui(a3, 1u), ori(a3, a3, serverBuffer & 0xFFFFu),
+            lui(t0, 1u), ori(t0, t0, queueData & 0xFFFFu),
+            sw(zero, sp, 0x10u), sw(zero, sp, 0x14u), sw(t0, sp, 0x18u),
+            jal(registerRpcStub), nop,
+            lw(ra, sp, 0x3Cu), move(v0, zero), jrRa, addiu(sp, sp, 0x40u),
+        };
+        const std::vector<uint32_t> helper = {
+            addiu(sp, sp, 0xFFE0u), sw(ra, sp, 0x1Cu),
+            addiu(a0, zero, 1000u), jal(delayThreadStub), nop,
+            addiu(t0, zero, 0x5Au), lui(at, 1u), sw(t0, at, markerSlot),
+            lui(at, 1u), lw(a0, at, semaSlot), jal(signalSemaStub), nop,
+            lw(ra, sp, 0x1Cu), move(v0, zero), jrRa, addiu(sp, sp, 0x20u),
+        };
+        const std::vector<uint32_t> server = {
+            addiu(sp, sp, 0xFFE0u), sw(ra, sp, 0x1Cu), sw(a1, sp, 0x18u),
+            lui(at, 1u), lw(a0, at, semaSlot), jal(waitSemaStub), nop,
+            lui(at, 1u), lw(t0, at, markerSlot),
+            lw(v0, sp, 0x18u), nop, sw(t0, v0, 0u),
+            lw(ra, sp, 0x1Cu), nop, jrRa, addiu(sp, sp, 0x20u),
+        };
+        const std::vector<uint32_t> thbase = {
+            0x41E00000u, 0u, 0x00000101u, 0x61626874u, 0x00006573u,
+            jrRa, 0x24000004u, jrRa, 0x24000006u, jrRa, 0x24000021u, 0u, 0u,
+        };
+        const std::vector<uint32_t> thsemap = {
+            0x41E00000u, 0u, 0x00000101u, 0x65736874u, 0x0070616Du,
+            jrRa, 0x24000004u, jrRa, 0x24000006u, jrRa, 0x24000008u, 0u, 0u,
+        };
+        const std::vector<uint32_t> sifcmd = {
+            0x41E00000u, 0u, 0x00000101u, 0x63666973u, 0x0000646Du,
+            jrRa, 0x24000011u, 0u, 0u,
+        };
+
+        ElfHeader header{};
+        header.ident[0] = 0x7Fu; header.ident[1] = 'E'; header.ident[2] = 'L'; header.ident[3] = 'F';
+        header.ident[4] = 1u; header.ident[5] = 1u; header.ident[6] = 1u;
+        header.type = 2u; header.machine = 8u; header.version = 1u;
+        header.entry = loadAddress; header.phoff = sizeof(ElfHeader);
+        header.ehsize = sizeof(ElfHeader); header.phentsize = sizeof(ProgramHeader); header.phnum = 1u;
+
+        ProgramHeader program{};
+        program.type = 1u; program.offset = codeOffset; program.vaddr = loadAddress; program.paddr = loadAddress;
+        program.filesz = 0x700u; program.memsz = 0x700u; program.flags = 7u; program.align = 4u;
+
+        std::vector<uint8_t> segment(program.filesz, 0u);
+        const auto place = [&](uint32_t target, const std::vector<uint32_t> &words)
+        { std::memcpy(segment.data() + (target - loadAddress), words.data(), words.size() * sizeof(uint32_t)); };
+        place(loadAddress, entry);
+        place(helperThread, helper);
+        place(serverFunction, server);
+        place(thbaseTable, thbase);
+        place(thsemapTable, thsemap);
+        place(sifcmdTable, sifcmd);
+        std::memset(host.guest.data() + address, 0, codeOffset + program.filesz);
+        std::memcpy(host.guest.data() + address, &header, sizeof(header));
+        std::memcpy(host.guest.data() + address + sizeof(header), &program, sizeof(program));
+        std::memcpy(host.guest.data() + address + codeOffset, segment.data(), segment.size());
+    }
+
+
+    int testBlockingRpcServer()
+    {
+        TestHost host(0x20000u);
+        IopSubsystem iop(host);
+        constexpr uint32_t sid = 0xB10C0001u;
+        writeBlockingRpcServerIrx(host, 0x100u, sid);
+        const ModuleLoadResult module = iop.loadModuleBuffer(0x100u);
+        if (!expect(module.handled && module.startResult == 0, "Blocking RPC server IRX did not start")) return 1;
+        if (!expect(iop.canBindRpc(sid), "Blocking RPC server was not registered")) return 1;
+
+        std::memset(host.guest.data() + 0x800u, 0xEE, sizeof(uint32_t));
+        RpcRequest request{};
+        request.sid = sid;
+        request.receive = {0x800u, sizeof(uint32_t)};
+        const RpcResult result = iop.handleRpc(request);
+        uint32_t marker = 0u;
+        std::memcpy(&marker, host.guest.data() + 0x800u, sizeof(marker));
+        if (!expect(result.handled, "Blocking RPC was not handled")) return 1;
+        if (!expect(marker == 0x5Au, "RPC server did not wait for the semaphore another IOP thread signals")) return 1;
+        return 0;
+    }
+
+    int testUnalignedLoadPair()
+    {
+        TestHost host(0x20000u);
+        IopSubsystem iop(host);
+        constexpr uint32_t sid = 0xB10C0002u;
+        writeRpcServerIrx(host, 0x100u, sid);
+        const ModuleLoadResult module = iop.loadModuleBuffer(0x100u);
+        if (!expect(module.handled && module.startResult == 0, "Unaligned-load RPC server IRX did not start")) return 1;
+
+        const uint8_t data[8] = {0x11u, 0x22u, 0x33u, 0x44u, 0x55u, 0x66u, 0x77u, 0x88u};
+        const uint32_t handler[] = {
+            0x3C090001u, 0x35290480u,
+            0x89280006u, 0x99280003u,
+            0x3C020001u, 0x34420400u,
+            0xAC480000u,
+            0x03E00008u, 0x00000000u,
+        };
+        if (!expect(iop.writeMemory(0x00010480u, data, sizeof(data)) &&
+                        iop.writeMemory(0x00010300u, handler, sizeof(handler)),
+                    "Could not install the unaligned-load handler")) return 1;
+        RpcRequest request{};
+        request.sid = sid;
+        request.receive = {0x800u, sizeof(uint32_t)};
+        const RpcResult result = iop.handleRpc(request);
+        uint32_t value = 0u;
+        std::memcpy(&value, host.guest.data() + 0x800u, sizeof(value));
+        if (!expect(result.handled && value == 0x77665544u,
+                    "LWR right after LWL must merge with the pending LWL value")) return 1;
+        return 0;
+    }
+}
+
+int main(){return testBlockingRpcServer();}
diff --git a/ps2xIOP/tests/iop_spu2_mixer_tests.cpp b/ps2xIOP/tests/iop_spu2_mixer_tests.cpp
new file mode 100644
index 0000000..ef77640
--- /dev/null
+++ b/ps2xIOP/tests/iop_spu2_mixer_tests.cpp
@@ -0,0 +1,43 @@
+#include "emulator/devices/iop_spu2.h"
+#include <iostream>
+#include <vector>
+using ps2x::iop::detail::IopSpu2;
+
+// Register expectations derived independently from PCSX2's PS2-mode ATTR/MMIX
+// handling. No game assets or host audio device required.
+std::vector<int16_t> render(uint16_t attr, uint16_t core1Mixer, uint16_t extVolume=0x7fff)
+{
+    IopSpu2 spu;
+    std::vector<int16_t> result;
+    spu.setAudioSink([&](std::span<const int16_t> samples){result.insert(result.end(),samples.begin(),samples.end());});
+    auto write=[&](uint32_t offset,uint16_t value){spu.write16(IopSpu2::kBase+offset,value,0);};
+    write(0x1a8,0);write(0x1aa,0x5000);
+    for(unsigned block=0;block<2;block++)for(unsigned word=0;word<8;word++)
+        write(0x1ac,word==0?(block==0?0x0400:0x0300):0x1111);
+    write(0x1c0,0);write(0x1c2,0x5000);
+    write(0,0x3fff);write(2,0x2000);write(4,0x1000);write(6,0x000f);write(8,0);
+    write(0x188,1);write(0x190,1);write(0x198,0xc00);write(0x19a,attr);
+    write(0x760,0x3fff);write(0x762,0x3fff);
+    write(0x598,core1Mixer);write(0x59a,attr);write(0x788,0x3fff);write(0x78a,0x3fff);
+    write(0x790,extVolume);write(0x792,extVolume);
+    write(0x794,0x7fff);write(0x796,0x7fff); // input volume cannot replace external volume
+    write(0x1a0,1);write(0xa,0x7fff);
+    spu.advanceTo(8*IopSpu2::kCyclesPerSample);spu.flushAudio();
+    return result;
+}
+int main()
+{
+    int failures=0;
+    auto expect=[&](bool pass,const char*name){std::cout<<(pass?"PASS ":"FAIL ")<<name<<'\n';failures+=!pass;};
+    auto audible=[](const auto&v){return v.size()==16&&v[14]>=4000&&v[14]<4096&&v[15]>=2000&&v[15]<2048;};
+    auto silent=[](const auto&v){for(auto x:v)if(x)return false;return v.size()==16;};
+    auto normal=render(0x8000,0x00c);
+    expect(audible(normal),"PS2 ATTR=8000 and external dry gates produce stereo voice PCM");
+    expect(audible(render(0xc000,0x00c)),"external dry routing remains audible with ATTR bit14 set");
+    expect(normal==render(0xc000,0x00c),"PS2 ATTR bit14 is not an inverted PS1 unmute gate");
+    expect(silent(render(0xc000,0x0c0)),"input gates alone cannot pass external core output");
+    expect(silent(render(0xc000,0x00c,0)),"zero external volume silences core0 despite nonzero input volume");
+    auto right=render(0x8000,0x004);
+    expect(right.size()==16&&right[14]==0&&right[15]>=2000,"external dry left and right gates are independent");
+    return failures?1:0;
+}
diff --git a/ps2xIOP/tests/iop_spu2_tests.cpp b/ps2xIOP/tests/iop_spu2_tests.cpp
new file mode 100644
index 0000000..05ed9f3
--- /dev/null
+++ b/ps2xIOP/tests/iop_spu2_tests.cpp
@@ -0,0 +1,224 @@
+#include "emulator/core/iop_memory.h"
+#include "emulator/devices/iop_spu2.h"
+
+#include <cstdint>
+#include <iostream>
+#include <string_view>
+#include <vector>
+
+namespace
+{
+    using namespace ps2x::iop::detail;
+
+    int g_failures = 0;
+
+    void expect(bool condition, std::string_view what)
+    {
+        if (!condition)
+        {
+            ++g_failures;
+            std::cerr << "FAILED: " << what << "\n";
+        }
+    }
+
+    constexpr uint32_t kSpu = 0x1F900000u;
+    constexpr uint32_t kBlockHalfwords = 8u;
+
+    struct Rig
+    {
+        IopMemory memory;
+        IopSpu2 spu2;
+        uint64_t clock = 0u;
+
+        Rig()
+        {
+            memory.attachSpu2(&spu2, &clock);
+        }
+
+        void write(uint32_t offset, uint16_t value) { memory.write16(kSpu + offset, value); }
+        uint16_t read(uint32_t offset) { return memory.read16(kSpu + offset); }
+        void samples(uint64_t count) { clock += count * IopSpu2::kCyclesPerSample; }
+
+        void uploadBlocks(uint32_t address, const uint8_t *flags, uint32_t blocks)
+        {
+            write(0x1A8, static_cast<uint16_t>(address >> 16));
+            write(0x1AA, static_cast<uint16_t>(address));
+            for (uint32_t block = 0; block < blocks; ++block)
+                for (uint32_t half = 0; half < kBlockHalfwords; ++half)
+                    write(0x1AC, half == 0u ? static_cast<uint16_t>(flags[block] << 8) : uint16_t{0x1111});
+        }
+
+        void setupVoice(uint32_t voice, uint32_t start, uint16_t pitch)
+        {
+            write(voice * 0x10u + 4u, pitch);
+            write(voice * 0x10u + 6u, 0x000Fu);
+            write(voice * 0x10u + 8u, 0x0000u);
+            write(0x1C0u + voice * 0xCu, static_cast<uint16_t>(start >> 16));
+            write(0x1C2u + voice * 0xCu, static_cast<uint16_t>(start));
+        }
+
+        uint32_t nax(uint32_t voice)
+        {
+            return (static_cast<uint32_t>(read(0x1C8u + voice * 0xCu)) << 16) | read(0x1CAu + voice * 0xCu);
+        }
+    };
+
+    void testStreamLoop()
+    {
+        Rig rig;
+        const uint8_t flags[4] = {0x4, 0x0, 0x0, 0x3};
+        rig.uploadBlocks(0x5000u, flags, 4u);
+        expect(rig.spu2.ram()[0x5000u] == 0x0400u, "PIO writes the block header into SPU2 RAM");
+        expect(rig.spu2.ram()[0x5001u] == 0x1111u, "PIO advances the transfer address");
+        rig.setupVoice(3u, 0x5000u, 0x1000u);
+        rig.write(0x1A0, 1u << 3);
+        expect(rig.nax(3u) == 0x5000u, "key on points NAX at the start address");
+        rig.samples(29u);
+        expect(rig.nax(3u) >= 0x5008u && rig.nax(3u) < 0x5010u, "NAX is in the second block after 29 samples at pitch 0x1000");
+        expect((rig.read(0x340) & (1u << 3)) == 0u, "no ENDX before the loop end");
+        rig.samples(28u * 3u);
+        expect((rig.read(0x340) & (1u << 3)) != 0u, "ENDX set at the loop-end block");
+        expect(rig.nax(3u) >= 0x5000u && rig.nax(3u) < 0x5008u, "loop repeat jumps back to the loop-start block");
+        expect(rig.spu2.loopAddress(0u, 3u) == 0x5000u, "loop-start flag sets LSAX");
+        expect(rig.read(3u * 0x10u + 0xAu) != 0u, "envelope still up while looping");
+        rig.write(0x340, 0xFFFFu);
+        expect((rig.read(0x340) & (1u << 3)) == 0u, "writing ENDX clears it");
+    }
+
+    void testEndWithoutRepeatStopsEnvelope()
+    {
+        Rig rig;
+        const uint8_t flags[2] = {0x4, 0x1};
+        rig.uploadBlocks(0x6000u, flags, 2u);
+        rig.setupVoice(0u, 0x6000u, 0x1000u);
+        rig.write(0x1A0, 1u);
+        rig.samples(10u);
+        expect(rig.read(0xAu) != 0u, "attack raises ENVX");
+        rig.samples(28u * 2u);
+        expect(rig.read(0xAu) == 0u, "loop end without repeat silences the voice");
+        expect((rig.read(0x340) & 1u) != 0u, "ENDX set for the stopped voice");
+    }
+
+    void testHalfPitch()
+    {
+        Rig rig;
+        const uint8_t flags[4] = {0x4, 0x0, 0x0, 0x3};
+        rig.uploadBlocks(0x7000u, flags, 4u);
+        rig.setupVoice(20u, 0x7000u, 0x0800u);
+        rig.write(0x1A2, 1u << 4);
+        rig.samples(54u);
+        expect(rig.nax(20u) >= 0x7000u && rig.nax(20u) < 0x7008u, "half pitch consumes half as many samples");
+        rig.samples(6u);
+        expect(rig.nax(20u) >= 0x7008u && rig.nax(20u) < 0x7010u, "half pitch reaches the second block after 60 samples");
+    }
+
+    void testCore1AndKeyOnIsolation()
+    {
+        Rig rig;
+        const uint8_t flags[2] = {0x4, 0x3};
+        rig.uploadBlocks(0x8000u, flags, 2u);
+        rig.setupVoice(1u, 0x8000u, 0x1000u);
+        rig.setupVoice(17u, 0x8000u, 0x1000u);
+        rig.write(0x1A0, 1u << 1);
+        expect(rig.spu2.envelope(0u, 17u) == 0 && rig.nax(17u) == 0u, "a 16-bit KON0 write does not key on KON1 voices");
+        rig.write(0x400u + 0x1C0u, 0u);
+        rig.write(0x400u + 0x1C2u, 0x8000u);
+        rig.write(0x400u + 4u, 0x1000u);
+        rig.write(0x400u + 6u, 0x000Fu);
+        rig.write(0x400u + 0x1A0u, 1u);
+        rig.samples(40u);
+        rig.spu2.advanceTo(rig.clock);
+        expect(rig.spu2.nextAddress(1u, 0u) >= 0x8008u, "core 1 voices play");
+        expect(rig.spu2.nextAddress(0u, 1u) >= 0x8008u, "core 0 voice keeps playing");
+    }
+
+    void testDmaCopiesIntoSpuRam()
+    {
+        Rig rig;
+        for (uint32_t i = 0; i < 64u; ++i)
+            rig.memory.write8(0x10000u + i, static_cast<uint8_t>(i));
+        rig.write(0x1A8, 0u);
+        rig.write(0x1AA, 0x2400u);
+        rig.memory.write32(0x1F8010C0u, 0x10000u);
+        rig.memory.write32(0x1F8010C4u, (1u << 16) | 16u);
+        rig.memory.write32(0x1F8010C8u, 0x01000201u);
+        expect(rig.spu2.ram()[0x2400u] == 0x0100u && rig.spu2.ram()[0x241Fu] == 0x3F3Eu, "DMA channel 4 writes IOP RAM into SPU2 RAM at TSA");
+        expect(rig.spu2.transferAddress(0u) == 0x2420u, "DMA advances TSA");
+        expect((rig.read(0x344) & 0x80u) != 0u, "DMA start sets the STATX ready bit");
+        const auto dma = rig.memory.takeDmaStart();
+        expect(dma.has_value() && dma->irq == 0x24, "DMA completion interrupt is scheduled");
+    }
+
+    void testStereoPcmAndState()
+    {
+        Rig rig;
+        std::vector<int16_t> output;
+        rig.spu2.setAudioSink([&](std::span<const int16_t> samples) { output.insert(output.end(), samples.begin(), samples.end()); });
+        const uint8_t flags[2] = {0x4, 0x3};
+        rig.uploadBlocks(0x5000u, flags, 2u);
+        rig.setupVoice(0u, 0x5000u, 0x1000u);
+        rig.write(0u, 0x3FFFu);
+        rig.write(2u, 0x2000u);
+        rig.write(0x188u, 1u);
+        rig.write(0x190u, 1u);
+        rig.write(0x198u, 0xC00u);
+        rig.write(0x19Au, 0x8000u);
+        rig.write(0x760u, 0x3FFFu);
+        rig.write(0x762u, 0x3FFFu);
+        rig.write(0x598u, 0x0Cu);
+        rig.write(0x59Au, 0x8000u);
+        rig.write(0x788u, 0x3FFFu);
+        rig.write(0x78Au, 0x3FFFu);
+        rig.write(0x790u, 0x7FFFu);
+        rig.write(0x792u, 0x7FFFu);
+        rig.write(0x1A0u, 1u);
+        rig.write(0xAu, 0x7FFFu);
+        rig.samples(8u);
+        rig.spu2.advanceTo(rig.clock);
+        rig.spu2.flushAudio();
+        expect(output.size() == 16u && output[14] >= 4000 && output[14] < 4096 && output[15] >= 2000 && output[15] < 2048,
+               "Gaussian interpolation preserves steady ADPCM levels and stereo balance through both cores");
+        rig.write(4u, 0x1234u);
+        rig.samples(17u);
+        rig.spu2.advanceTo(rig.clock);
+        rig.spu2.flushAudio();
+        ps2x::state::Writer saved;
+        rig.spu2.serialize(saved);
+        output.clear();
+        rig.samples(87u);
+        rig.spu2.advanceTo(rig.clock);
+        rig.spu2.flushAudio();
+        const auto expected = output;
+        output.clear();
+        ps2x::state::Reader reader(saved.data().data(), saved.data().size());
+        rig.spu2.serialize(reader);
+        rig.spu2.advanceTo(rig.clock);
+        rig.spu2.flushAudio();
+        expect(output == expected && reader.remaining() == 0u, "save state restores decoder history and fractional pitch exactly");
+        output.clear();
+        rig.write(0x190u, 0u);
+        rig.samples(4u);
+        rig.spu2.advanceTo(rig.clock);
+        rig.spu2.flushAudio();
+        expect(output.size() == 8u && output[0] > 0 && output[1] == 0, "voice mixer masks silence one stereo channel");
+        output.clear();
+        rig.write(0x1A4u, 1u);
+        rig.samples(200u);
+        rig.spu2.advanceTo(rig.clock);
+        rig.spu2.flushAudio();
+        expect(output.size() == 400u && output[398] == 0 && output[399] == 0, "key off releases audible PCM to silence");
+    }
+}
+
+int main()
+{
+    testStreamLoop();
+    testEndWithoutRepeatStopsEnvelope();
+    testHalfPitch();
+    testCore1AndKeyOnIsolation();
+    testDmaCopiesIntoSpuRam();
+    testStereoPcmAndState();
+    if (g_failures == 0)
+        std::cout << "iop_spu2_tests: all passed\n";
+    return g_failures == 0 ? 0 : 1;
+}
