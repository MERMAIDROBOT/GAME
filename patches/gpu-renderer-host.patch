new file mode 100644
index 0000000..8279f84
--- /dev/null
+++ b/ps2xRuntime/include/runtime/presentation_pacing.hpp
@@ -0,0 +1,33 @@
+#pragma once
+// Window pacing. PS2_PORT_DISPLAY_VSYNC=1 presents on the display's refresh instead of a 60 Hz timer, so frames
+// are not dropped or doubled against the panel. PS2_PORT_PRESENT_TRACE=FILE records each swap (ns, field tick,
+// generation, ingress sequence) for frame-pacing analysis.
+#include <chrono>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+
+namespace PresentationPacing
+{
+    inline bool vsync()
+    {
+        static const bool value = [] { const char *v = std::getenv("PS2_PORT_DISPLAY_VSYNC"); return v && *v == '1'; }();
+        return value;
+    }
+    inline uint64_t tick = 0, generation = 0, ingress = 0;
+    inline void uploaded(uint64_t t, uint64_t g, uint64_t i) { tick = t; generation = g; ingress = i; }
+    inline void swapped()
+    {
+        static FILE *file = [] {
+            const char *path = std::getenv("PS2_PORT_PRESENT_TRACE");
+            FILE *f = path ? std::fopen(path, "w") : nullptr;
+            if (f) std::setvbuf(f, nullptr, _IOFBF, 65536);
+            return f;
+        }();
+        if (!file) return;
+        const auto ns = std::chrono::duration_cast<std::chrono::nanoseconds>(std::chrono::steady_clock::now().time_since_epoch()).count();
+        std::fprintf(file, "%lld,%llu,%llu,%llu\n", (long long)ns, (unsigned long long)tick, (unsigned long long)generation, (unsigned long long)ingress);
+        static unsigned count = 0;
+        if (++count % 120 == 0) std::fflush(file);
+    }
+}
