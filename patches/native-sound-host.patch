+    Mixer::Stats Mixer::stats()
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        Stats stats = m_stats;
+        stats.voicesPlaying = 0;
+        for (const Group &group : m_groups)
+            for (const Voice &voice : group.voices)
+                stats.voicesPlaying += voice.phase != Voice::Phase::Off ? 1 : 0;
+        m_stats.peak = 0;
+        return stats;
+    }
