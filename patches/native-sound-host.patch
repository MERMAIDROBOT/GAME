@@ -0,0 +1,151 @@
+// Adapter for BozoEngine's native IOP host inside the PS2 Port Lab runtime.
+// Replaces BozoEngine's full EE library layer with the few members compiled_libraries.cpp uses:
+// the SIF state, a clock, guest memory access and a print switch. Hooks are filled by the runtime bridge.
+// Heap is copied from BozoEngine runtime/libs/libraries.cpp (MIT, see ../../../LICENSE).
+#pragma once
+#include "bozo/libs/sif.h"
+#include <cstdint>
+#include <functional>
+#include <iterator>
+#include <map>
+#include <string>
+#include <unordered_map>
+
+namespace bozo::ee
+{
+    // The bulk-copy path (sifman 7/32) needs attached EE data; the bridge does not attach it, so dispatcher()
+    // returns nullptr and such a call fails explicitly. These declarations only satisfy the compiler.
+    struct EeMemoryView
+    {
+        uint8_t *hostPointer(uint32_t, uint32_t) { return nullptr; }
+        uint8_t *ram() { return nullptr; }
+    };
+    struct EeRuntimeView
+    {
+        EeMemoryView memory;
+    };
+    class Dispatcher
+    {
+      public:
+        EeRuntimeView &runtime() { return runtime_; }
+
+      private:
+        EeRuntimeView runtime_;
+    };
+}
+
+namespace bozo::libs
+{
+    constexpr uint32_t kSectorBytes = 2048;
+
+    // Guest (EE) memory as the native RPC servers read requests and write replies.
+    class Guest
+    {
+      public:
+        virtual ~Guest() = default;
+        virtual const uint8_t *in(uint32_t address, uint32_t bytes) const = 0;
+        virtual void write(uint32_t address, const uint8_t *data, uint32_t bytes) = 0;
+    };
+
+    // Native disc files are not enabled by the bridge (useNativeDiscFiles is never called).
+    struct DiscImage
+    {
+        bool isOpen() const { return false; }
+        bool open(const std::string &, std::string &error)
+        {
+            error = "native disc files are not enabled in this runtime";
+            return false;
+        }
+        uint64_t sectors() const { return 0; }
+        bool read(uint64_t, uint32_t, uint8_t *) { return false; }
+        bool findFile(const std::string &, uint32_t &, uint32_t &) { return false; }
+    };
+
+    struct CdState
+    {
+        struct File { uint32_t sector = 0, bytes = 0, position = 0; };
+        std::map<int32_t, File> files;
+        int32_t nextFile = 3;
+        DiscImage disc;
+        std::string imagePath;
+    };
+
+    class Heap
+    {
+      public:
+        void reset(uint32_t start, uint32_t end)
+        {
+            free_.clear();
+            used_.clear();
+            end_ = end;
+            if (end > start) free_[start] = end - start;
+        }
+        bool ready() const { return end_ != 0; }
+        uint32_t allocate(uint32_t bytes)
+        {
+            if (bytes > UINT32_MAX - 15u) return 0;
+            uint32_t n = (bytes + 15u) & ~15u;
+            if (n == 0) n = 16;
+            for (auto it = free_.begin(); it != free_.end(); ++it)
+                if (it->second >= n)
+                {
+                    const uint32_t a = it->first, left = it->second - n;
+                    free_.erase(it);
+                    if (left) free_[a + n] = left;
+                    used_[a] = n;
+                    return a;
+                }
+            return 0;
+        }
+        bool contains(uint32_t address, uint32_t bytes) const
+        {
+            for (const auto &[start, size] : used_)
+                if (address >= start && uint64_t(address) - start <= size &&
+                    bytes <= uint64_t(size) - (uint64_t(address) - start))
+                    return true;
+            return false;
+        }
+        bool release(uint32_t address)
+        {
+            auto u = used_.find(address);
+            if (u == used_.end()) return false;
+            uint32_t a = address, n = u->second;
+            used_.erase(u);
+            auto next = free_.lower_bound(a);
+            if (next != free_.end() && next->first == a + n)
+            {
+                n += next->second;
+                next = free_.erase(next);
+            }
+            if (next != free_.begin())
+            {
+                auto prev = std::prev(next);
+                if (prev->first + prev->second == a)
+                {
+                    prev->second += n;
+                    return true;
+                }
+            }
+            free_[a] = n;
+            return true;
+        }
+        size_t blocks() const { return used_.size(); }
+
+      private:
+        std::map<uint32_t, uint32_t> free_;
+        std::unordered_map<uint32_t, uint32_t> used_;
+        uint32_t end_ = 0;
+    };
+
+    class Libraries
+    {
+      public:
+        SifState sif;
+        CdState cd;
+        bool printOutput = false;
+        // The EE cycle of the call being served; the bridge installs it.
+        std::function<uint64_t(Guest &)> clock;
+        uint64_t now(Guest &guest) { return clock ? clock(guest) : 0; }
+        ee::Dispatcher *dispatcher() { return nullptr; }
+    };
+}
diff --git a/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/libs/sif.h b/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/libs/sif.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/libs/sif.h
@@ -0,0 +1,76 @@
+// The SIF layer as the native runtime answers it (libraries.md section 14): the EE side of the EE-IOP interface with
+// no IOP behind it. RPC calls go to native servers (TMB's only one: the 989SND sound driver, snd.h); module loading
+// loads nothing and gives the reference's module ids; the IOP heap is a model of the IOP memory the reference's
+// allocator handed out (989SND's banks and buffers come from it too).
+#pragma once
+
+#include <cstdint>
+#include <map>
+#include <functional>
+#include <string>
+#include <unordered_map>
+#include <span>
+#include <vector>
+
+namespace bozo::libs
+{
+    class Libraries;
+    class Guest;
+    struct NativeRpcRequest {
+        uint32_t command, send, sendBytes, receive, receiveBytes;
+    };
+    // IOP memory as the reference's IOP allocator gave it out (libraries.md section 14.3): blocks aligned to 16
+    // bytes, first fit by address, from the first byte its loaded modules left free; a freed block merges with its free
+    // neighbours.
+    class IopHeap
+    {
+    public:
+        static constexpr uint32_t kStart = 0x7FE60u; // the reference's first free byte after the IOP modules
+        static constexpr uint32_t kEnd = 0x200000u;  // 2 MB of IOP RAM
+        IopHeap() { reset(); }
+        void reset();
+        uint32_t allocate(uint32_t bytes); // 0 when no free block is large enough
+        bool release(uint32_t address);    // a block's start; false when it is not one in use
+        // The block in use that contains `address` (its start), 0 if none.
+        uint32_t blockAt(uint32_t address) const;
+        uint32_t largestFree() const;
+        uint32_t totalFree() const;
+
+    private:
+        std::map<uint32_t, uint32_t> free_; // start -> bytes
+        std::map<uint32_t, uint32_t> used_;
+    };
+
+    struct SifState
+    {
+        // The reference keeps the IOP side of each bound server (its SifRpcServerData) in EE RAM; the 989SND's at
+        // 0x1f10000. A call writes the request's fields there.
+        static constexpr uint32_t kServerData = 0x1F10000u;
+        // Native service providers registered by a port or reusable library. No IOP/device backend.
+        using RpcHandler = std::function<void(Libraries &, Guest &, const NativeRpcRequest &)>;
+        std::map<uint32_t, RpcHandler> servers;
+        // Native EE services that compiled IOP modules bind (sceSifBindRpc) and call (sceSifCallRpc) by service id: the
+        // command, the bytes sent, and the reply to fill (the caller's receive size). The call completes when it returns.
+        using EeRpcHandler = std::function<void(uint32_t, std::span<const uint8_t>, std::span<uint8_t>)>;
+        std::map<uint32_t, EeRpcHandler> eeServers;
+        std::function<void(uint32_t, const uint8_t *, uint32_t)> transfer;
+        std::function<int32_t(const std::string &)> moduleLoader;
+        // Takes the place of moduleLoader when set: also given sceSifLoadModule's arguments, split at their NULs.
+        std::function<int32_t(const std::string &, const std::vector<std::string> &)> moduleLoaderWithArguments;
+        std::function<void()> resetProvider;
+        std::function<uint32_t(uint32_t)> allocateBuffer;
+        std::function<bool(uint32_t)> freeBuffer;
+        // Direct native user-message receiver: command, data, extra destination/data.
+        // The receiver copies data and queues its actual application callback.
+        std::function<uint32_t(uint32_t,std::span<const uint8_t>,uint32_t,std::span<const uint8_t>)> receiveCommand;
+        uint32_t rpcId = 0;                       // the client headers' rpc_id: one more at each bind attempt
+        std::map<uint32_t, uint32_t> bindAttempts; // per service id
+        // The service each bound client header calls (by the client's address). The server data in EE RAM is the game's
+        // memory as much as ours (a level's heap reaches 0x1f10000 and overwrites it), so a call finds its server here.
+        std::map<uint32_t, uint32_t> bound;
+        uint32_t sreg[32] = {};
+        uint32_t dmaId = 0;  // the last SIF DMA transfer's id (sceSifSetDma: 1, 2, ...)
+        uint32_t modules = 0; // modules loaded since the IOP's reboot (their ids are 1, 2, ...)
+        IopHeap heap;
+    };
+}
diff --git a/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/native/compiled_irx.h b/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/native/compiled_irx.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/native/compiled_irx.h
@@ -0,0 +1,160 @@
+// SPDX-License-Identifier: MIT
+// Team-authored generated-code ABI moved after a per-line authorship audit (docs/native-irx.md).
+// Register values and plain library buffers for statically compiled routines. No CPU or device emulator.
+#pragma once
+#include <cstddef>
+#include <cstdint>
+
+namespace bozo::native::irx
+{
+    // Register values retained by generated native functions across cooperative yields.
+    struct NativeCpu
+    {
+        uint32_t gpr[32];
+        uint32_t hi;
+        uint32_t lo;
+        uint32_t pc;
+        uint32_t cop0[32];
+    };
+
+    class Env
+    {
+      public:
+        explicit Env(NativeCpu &cpu) : cpu(cpu) {}
+        virtual ~Env() = default;
+
+        NativeCpu &cpu;
+
+        // Reads as the guest sees them: the image/data buffer directly; addresses outside it must be rejected by the
+        // host.
+        uint8_t r8(uint32_t address)
+        {
+            const uint32_t physical = address & 0x1FFFFFFFu;
+            return physical < ramSize ? ram[physical] : read8(address);
+        }
+        uint16_t r16(uint32_t address)
+        {
+            const uint32_t physical = address & 0x1FFFFFFFu;
+            if (physical + 1u < ramSize)
+                return static_cast<uint16_t>(ram[physical] | (ram[physical + 1u] << 8));
+            return read16(address);
+        }
+        uint32_t r32(uint32_t address)
+        {
+            const uint32_t physical = address & 0x1FFFFFFFu;
+            if (physical + 3u < ramSize)
+                return static_cast<uint32_t>(ram[physical]) | (static_cast<uint32_t>(ram[physical + 1u]) << 8) |
+                       (static_cast<uint32_t>(ram[physical + 2u]) << 16) |
+                       (static_cast<uint32_t>(ram[physical + 3u]) << 24);
+            return read32(address);
+        }
+        // The native library image/data buffer (including streams refilled in place).
+        const uint8_t *ramBase() const { return ram; }
+        uint32_t ramBytes() const { return ramSize; }
+
+        // Writes are bounds-checked by the native host. There are no device-register effects.
+        void w8(uint32_t address, uint8_t value) { write8(address, value); }
+        void w16(uint32_t address, uint16_t value) { write16(address, value); }
+        void w32(uint32_t address, uint32_t value) { write32(address, value); }
+
+        // Work accounting for cooperative native callbacks.
+        void tick(uint32_t instructions) { executed += instructions; }
+        // The time slice is spent: a loop stops at its head (cpu.pc) and returns for the host to run other native
+        // callbacks.
+        bool expired() const { return executed >= budget; }
+
+        // A call (JAL / JALR, cpu.gpr[31] already set to ret): runs target and what it leads to, through statically
+        // linked functions and native SDK bindings, until the guest is back at ret. False when it stopped before (a
+        // blocking call, the end of the slice, a yielded callback): cpu.pc is where it goes on, and the caller returns
+        // at once.
+        virtual bool call(uint32_t target, uint32_t ret) = 0;
+
+        uint64_t executed = 0;
+        uint64_t budget = 0;
+
+      protected:
+        uint8_t *ram = nullptr;
+        uint32_t ramSize = 0;
+        virtual uint8_t read8(uint32_t address) = 0;
+        virtual uint16_t read16(uint32_t address) = 0;
+        virtual uint32_t read32(uint32_t address) = 0;
+        virtual void write8(uint32_t address, uint8_t value) = 0;
+        virtual void write16(uint32_t address, uint16_t value) = 0;
+        virtual void write32(uint32_t address, uint32_t value) = 0;
+    };
+
+    using Function = void (*)(Env &);
+
+    struct Entry
+    {
+        uint32_t pc;
+        Function function;
+    };
+
+    // Generated code: one per module, at namespace scope (static initialization).
+    struct Registration
+    {
+        Registration(const char *name, uint64_t fileHash, uint32_t base, uint32_t size, const Entry *entries,
+                     size_t count);
+    };
+
+    // R3000 integer division semantics, emitted as native arithmetic.
+    inline void divide(NativeCpu &c, uint32_t rs, uint32_t rt)
+    {
+        const int32_t lhs = static_cast<int32_t>(rs), rhs = static_cast<int32_t>(rt);
+        if (rhs == 0)
+        {
+            c.lo = lhs >= 0 ? 0xFFFFFFFFu : 1u;
+            c.hi = static_cast<uint32_t>(lhs);
+        }
+        else if (lhs == INT32_MIN && rhs == -1)
+        {
+            c.lo = static_cast<uint32_t>(lhs);
+            c.hi = 0u;
+        }
+        else
+        {
+            c.lo = static_cast<uint32_t>(lhs / rhs);
+            c.hi = static_cast<uint32_t>(lhs % rhs);
+        }
+    }
+    inline void divideUnsigned(NativeCpu &c, uint32_t rs, uint32_t rt)
+    {
+        if (rt == 0u)
+        {
+            c.lo = 0xFFFFFFFFu;
+            c.hi = rs;
+        }
+        else
+        {
+            c.lo = rs / rt;
+            c.hi = rs % rt;
+        }
+    }
+    inline uint32_t loadLeft(Env &e, uint32_t address, uint32_t old)
+    {
+        static constexpr uint32_t masks[4] = {0x00FFFFFFu, 0x0000FFFFu, 0x000000FFu, 0x00000000u};
+        static constexpr uint32_t shifts[4] = {24u, 16u, 8u, 0u};
+        return (old & masks[address & 3u]) | (e.r32(address & ~3u) << shifts[address & 3u]);
+    }
+    inline uint32_t loadRight(Env &e, uint32_t address, uint32_t old)
+    {
+        static constexpr uint32_t masks[4] = {0x00000000u, 0xFF000000u, 0xFFFF0000u, 0xFFFFFF00u};
+        static constexpr uint32_t shifts[4] = {0u, 8u, 16u, 24u};
+        return (old & masks[address & 3u]) | (e.r32(address & ~3u) >> shifts[address & 3u]);
+    }
+    inline void storeLeft(Env &e, uint32_t address, uint32_t value)
+    {
+        const uint32_t aligned = address & ~3u, old = e.r32(aligned);
+        static constexpr uint32_t masks[4] = {0xFFFFFF00u, 0xFFFF0000u, 0xFF000000u, 0x00000000u};
+        static constexpr uint32_t shifts[4] = {24u, 16u, 8u, 0u};
+        e.w32(aligned, (old & masks[address & 3u]) | (value >> shifts[address & 3u]));
+    }
+    inline void storeRight(Env &e, uint32_t address, uint32_t value)
+    {
+        const uint32_t aligned = address & ~3u, old = e.r32(aligned);
+        static constexpr uint32_t masks[4] = {0x00000000u, 0x000000FFu, 0x0000FFFFu, 0x00FFFFFFu};
+        static constexpr uint32_t shifts[4] = {0u, 8u, 16u, 24u};
+        e.w32(aligned, (old & masks[address & 3u]) | (value << shifts[address & 3u]));
+    }
+} // namespace bozo::native::irx
diff --git a/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/native/compiled_libraries.h b/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/native/compiled_libraries.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_sound/bozo/include/bozo/native/compiled_libraries.h
@@ -0,0 +1,71 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include "bozo/audio/libsd.h"
+#include "bozo/libs/libraries.h"
+#include "bozo/native/compiled_irx.h"
+#include <memory>
+#include <functional>
+#include <span>
+#include <string>
+#include <vector>
+namespace bozo::native::irx
+{
+    struct Import
+    {
+        uint32_t address;
+        std::string library;
+        uint32_t ordinal;
+    };
+    struct Image
+    {
+        std::string name;
+        uint64_t hash;
+        uint32_t base, entry, gp;
+        std::vector<uint8_t> bytes;
+        std::vector<Import> imports, exports;
+        bool nativeLibsd = false;
+    };
+    // Native host services for statically compiled sound libraries. Buffers and register values are ordinary
+    // C++ state. Every executable target must have a linked function or a native SDK binding. There is no
+    // instruction fetch/decode, CPU/device backend, firmware, interpreter or run-time code generation.
+    class CompiledLibraries
+    {
+      public:
+        explicit CompiledLibraries(libs::Libraries &libraries, uint32_t heapStart);
+        ~CompiledLibraries();
+        void addImage(Image image);
+        // Replace a linked game routine with a per-host native algorithm.
+        // Only entries belonging to an admitted image may be bound, before it starts.
+        // Captured application state is owned by the caller and must outlive this host.
+        void bindNative(uint32_t address, std::function<void(Env &)> function);
+        // Deliver already completed native audio jobs at linked-call safe points.
+        // Opt in before execution; existing ports retain their callback schedule.
+        void useReadyAudioCompletions();
+        // Map linked frame listeners to actual native game-frame completions.
+        // Opt in before execution; no display interrupt or frame period is generated.
+        void useNativeFrameCallbacks();
+        // Opt-in file I/O for compiled SDK disc callers. Reads copy actual ISO
+        // bytes synchronously; sync queries owned work, and callbacks are native
