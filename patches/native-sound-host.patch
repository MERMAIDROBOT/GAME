+                    move >>= 1;
+                    gain >>= 1;
+                }
+                else
+                    gain >>= 2;
+            }
+            counter += gain;
+            if (counter < 0x8000u)
+                return;
+            counter = 0;
+            level = std::clamp(level + move, 0, 0x7FFF);
+        }
