+
+    void Mixer::advanceTo(uint64_t iopCycle)
+    {
+        const uint64_t due = iopCycle / kIopCyclesPerSample;
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (!m_clocked)
+            return;
+        if (!m_clockStarted || due < m_samplesMade) // the first call, or the IOP's clock restarted (a reset)
+        {
+            m_clockStarted = true;
+            m_samplesMade = due;
+            return;
+        }
+        if (due == m_samplesMade)
+            return;
+        const size_t frames = static_cast<size_t>(std::min<uint64_t>(due - m_samplesMade, kQueueFrames));
+        m_samplesMade = due;
+        m_scratch.resize(frames * 2u);
+        m_stats.frames += frames;
+        mix(m_scratch.data(), frames);
+        noteMixed(m_scratch.data(), frames);
+        std::lock_guard<std::mutex> queueLock(m_queueMutex);
+        for (size_t i = 0; i < frames; ++i)
+        {
+            if (m_queueFill == kQueueFrames) // the device fell behind: the oldest goes
+            {
+                m_queueRead = (m_queueRead + 1u) % kQueueFrames;
+                --m_queueFill;
+            }
+            const size_t at = (m_queueRead + m_queueFill) % kQueueFrames;
+            m_queue[at * 2u] = m_scratch[i * 2u];
+            m_queue[at * 2u + 1u] = m_scratch[i * 2u + 1u];
+            ++m_queueFill;
+        }
+    }
+
+    void Mixer::render(int16_t *out, size_t frames)
+    {
+        if (m_clocked)
+        {
+            // The device's thread: only the queue, never the mixer's state.
+            std::lock_guard<std::mutex> queueLock(m_queueMutex);
+            const size_t taken = std::min(frames, m_queueFill);
+            for (size_t i = 0; i < taken; ++i)
+            {
+                out[i * 2u] = m_queue[m_queueRead * 2u];
+                out[i * 2u + 1u] = m_queue[m_queueRead * 2u + 1u];
+                m_queueRead = (m_queueRead + 1u) % kQueueFrames;
+            }
+            m_queueFill -= taken;
+            std::fill(out + taken * 2u, out + frames * 2u, int16_t{0});
+            return;
+        }
+        {
+            std::lock_guard<std::mutex> lock(m_mutex);
+            m_stats.frames += frames;
+            mix(out, frames);
+        }
+        noteMixed(out, frames);
+    }
+
+    size_t Mixer::take(int16_t *out, size_t frames)
+    {
+        std::lock_guard<std::mutex> queueLock(m_queueMutex);
+        const size_t taken = std::min(frames, m_queueFill);
+        for (size_t i = 0; i < taken; ++i)
+        {
+            out[i * 2u] = m_queue[m_queueRead * 2u];
+            out[i * 2u + 1u] = m_queue[m_queueRead * 2u + 1u];
+            m_queueRead = (m_queueRead + 1u) % kQueueFrames;
+        }
+        m_queueFill -= taken;
+        return taken;
+    }
+
+    size_t Mixer::queuedFrames()
+    {
+        std::lock_guard<std::mutex> queueLock(m_queueMutex);
+        return m_queueFill;
+    }
+
+    void Mixer::mix(int16_t *out, size_t frames)
+    {
+        for (size_t frame = 0; frame < frames; ++frame)
+        {
+            // Group 0's output goes into group 1 (as its external input, through group 1's master volume).
+            int32_t mixed[2] = {0, 0};
+            for (int g = 0; g < kGroups; ++g)
+            {
+                Group &group = m_groups[g];
+                int32_t dry[2] = {0, 0}, wet[2] = {0, 0};
+                int32_t input[2] = {0, 0};
+                if (group.input.playing)
+                {
+                    Input &in = group.input;
+                    const uint32_t at = inputOffsetOf(in.position);
+                    for (int side = 0; side < 2; ++side)
+                    {
+                        const uint8_t *p = in.memory + at + static_cast<uint32_t>(side) * 512u;
+                        input[side] = mul15(static_cast<int16_t>(static_cast<uint16_t>(p[0] | (p[1] << 8u))), in.volume[side]);
+                    }
+                    ++in.position;
+                    const uint32_t half = in.samples / 2u;
+                    if (in.position == half || in.position >= in.samples)
+                    {
+                        const int which = in.position == half ? 0 : 1;
+                        if (in.position >= in.samples)
+                        {
+                            in.position = 0u;
+                            in.playing = in.loop;
+                        }
+                        ++m_stats.halves;
+                        if (m_inputHalf)
+                            m_inputHalf(g, which);
+                    }
+                }
+                for (int index = 0; index < kVoices; ++index)
+                {
+                    Voice &voice = group.voices[index];
+                    voice.volume[0].tick();
+                    voice.volume[1].tick();
+                    if (voice.phase == Voice::Phase::Off)
+                        continue;
+                    const int32_t value = sample(group, index, voice);
+                    const uint32_t bit = 1u << index;
+                    if ((group.dry[0] & bit) != 0u)
+                        dry[0] += mul15(value, voice.volume[0].level);
+                    if ((group.dry[1] & bit) != 0u)
+                        dry[1] += mul15(value, voice.volume[1].level);
+                    if ((group.wet[0] & bit) != 0u)
+                        wet[0] += mul15(value, voice.volume[0].level);
+                    if ((group.wet[1] & bit) != 0u)
+                        wet[1] += mul15(value, voice.volume[1].level);
+                }
+                // The reverb: the send averaged over two output samples, a step every other sample, its output
+                // eased between steps; at the group's effect volume.
+                int32_t returned[2] = {0, 0};
+                Reverb &reverb = group.reverb;
+                group.effect[0].tick();
+                group.effect[1].tick();
+                if (reverb.enabled && reverb.mode != 0)
+                {
+                    int32_t send[2] = {clamp16(wet[0]), clamp16(wet[1])};
+                    if ((group.mix & 0x200u) == 0u)
+                        send[0] = 0;
+                    if ((group.mix & 0x100u) == 0u)
+                        send[1] = 0;
+                    send[0] += (group.mix & 0x20u) != 0u ? input[0] : 0;
+                    send[1] += (group.mix & 0x10u) != 0u ? input[1] : 0;
+                    if (g == 1)
+                    {
+                        send[0] += (group.mix & 0x2u) != 0u ? mixed[0] : 0;
+                        send[1] += (group.mix & 0x1u) != 0u ? mixed[1] : 0;
+                    }
+                    send[0] = clamp16(send[0]);
+                    send[1] = clamp16(send[1]);
+                    if (reverb.phase)
+                    {
+                        const int32_t average[2] = {(reverb.input[0] + send[0]) >> 1, (reverb.input[1] + send[1]) >> 1};
+                        reverb.previous[0] = reverb.out[0];
+                        reverb.previous[1] = reverb.out[1];
+                        stepReverb(reverb, average, reverb.out);
+                    }
+                    else
+                    {
+                        reverb.input[0] = send[0];
+                        reverb.input[1] = send[1];
+                    }
+                    for (int side = 0; side < 2; ++side)
+                    {
+                        const int32_t value = reverb.phase ? (reverb.previous[side] + reverb.out[side]) >> 1 : reverb.out[side];
+                        returned[side] = mul15(value, group.effect[side].level);
+                    }
+                    reverb.phase = !reverb.phase;
+                }
+                group.master[0].tick();
+                group.master[1].tick();
+                for (int side = 0; side < 2; ++side)
+                {
+                    // The dry switches: the voices (bits 11 / 10, left / right), the input (7 / 6), group 0 (3 / 2).
+                    const uint32_t shift = side == 0 ? 1u : 0u;
+                    int32_t level = returned[side];
+                    if ((group.mix & (0x400u << shift)) != 0u)
+                        level += clamp16(dry[side]);
+                    if ((group.mix & (0x40u << shift)) != 0u)
+                        level += input[side];
+                    level = clamp16(level);
+                    if (g == 0)
+                        mixed[side] = mul15(level, group.master[side].level);
+                    else
+                        mixed[side] = clamp16(((group.mix & (0x4u << shift)) != 0u ? mixed[side] : 0) + level);
+                }
+                if (g == kGroups - 1)
+                    for (int side = 0; side < 2; ++side)
+                        mixed[side] = mul15(mixed[side], group.master[side].level);
+            }
+            if (int16_t stream[2]; m_portStream && m_portStream->pull(stream))
+            {
+                mixed[0] += stream[0];
+                mixed[1] += stream[1];
+            }
+            out[frame * 2u] = static_cast<int16_t>(clamp16(mixed[0]));
+            out[frame * 2u + 1u] = static_cast<int16_t>(clamp16(mixed[1]));
+            m_stats.peak = std::max({m_stats.peak, std::abs(clamp16(mixed[0])), std::abs(clamp16(mixed[1]))});
+        }
+    }
+}
diff --git a/ps2xRuntime/src/lib/native_sound/bozo/src/port_stream.cpp b/ps2xRuntime/src/lib/native_sound/bozo/src/port_stream.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_sound/bozo/src/port_stream.cpp
@@ -0,0 +1,44 @@
+#include "bozo/audio/port_stream.h"
+
+#include <algorithm>
+
+namespace bozo::audio
+{
+    size_t PortStream::push(const int16_t *frames, size_t count)
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        const size_t taken = std::min(count, kFrames - m_fill);
+        for (size_t i = 0; i < taken; ++i)
+        {
+            const size_t at = (m_read + m_fill + i) % kFrames;
+            m_ring[at * 2u] = frames[i * 2u];
+            m_ring[at * 2u + 1u] = frames[i * 2u + 1u];
+        }
+        m_fill += taken;
+        return taken;
+    }
+
+    size_t PortStream::queued() const
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        return m_fill;
+    }
+
+    void PortStream::clear()
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        m_read = m_fill = 0;
+    }
+
+    bool PortStream::pull(int16_t out[2])
+    {
+        std::lock_guard<std::mutex> lock(m_mutex);
+        if (m_fill == 0)
+            return false;
+        out[0] = m_ring[m_read * 2u];
+        out[1] = m_ring[m_read * 2u + 1u];
+        m_read = (m_read + 1u) % kFrames;
+        --m_fill;
+        return true;
+    }
+}
diff --git a/ps2xRuntime/src/lib/native_sound/ps2_native_sound.cpp b/ps2xRuntime/src/lib/native_sound/ps2_native_sound.cpp
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_sound/ps2_native_sound.cpp
@@ -0,0 +1,219 @@
+// Native IOP sound bridge (see ps2_native_sound.h). BozoEngine's host (MIT, runtime/native_sound/bozo) runs the
+// compiled driver; this file connects it to the runtime's RPC, SIF command, SIF DMA, clock and audio paths.
+#include "ps2_native_sound.h"
+#include "Stubs/SIF.h"
+#include "bozo/native/compiled_libraries.h"
+#include "ps2_runtime.h"
+#include "runtime/ps2_audio.h"
+#include <algorithm>
+#include <array>
+#include <cctype>
+#include <cstdlib>
+#include <cstring>
+#include <iostream>
+#include <map>
+#include <string>
+#include <vector>
+
+namespace
+{
+    std::vector<bozo::native::irx::Image> &registry()
+    {
+        static std::vector<bozo::native::irx::Image> images;
+        return images;
+    }
+
+    // "cdrom0:\DATA\MODULES\SNDDRV.IRX;1" -> "SNDDRV.IRX"
+    std::string moduleName(std::string_view path)
+    {
+        const auto slash = path.find_last_of("/\\:");
+        std::string name(slash == std::string_view::npos ? path : path.substr(slash + 1));
+        if (const auto version = name.find(';'); version != std::string::npos) name.resize(version);
+        for (char &c : name) c = static_cast<char>(std::toupper(static_cast<unsigned char>(c)));
+        return name;
+    }
+
+    class RdramGuest final : public bozo::libs::Guest
+    {
+      public:
+        explicit RdramGuest(uint8_t *rdram) : m_rdram(rdram) {}
+        const uint8_t *in(uint32_t address, uint32_t bytes) const override { return at(address, bytes); }
+        void write(uint32_t address, const uint8_t *data, uint32_t bytes) override
+        {
+            if (bytes) std::memcpy(at(address, bytes), data, bytes);
+        }
+
+      private:
+        uint8_t *at(uint32_t address, uint32_t bytes) const
+        {
+            const uint32_t physical = address & 0x1FFFFFFFu;
+            if (!m_rdram || physical >= PS2_RAM_SIZE || bytes > PS2_RAM_SIZE - physical)
+                throw std::runtime_error("native sound guest access outside EE RAM");
+            return m_rdram + physical;
+        }
+        uint8_t *m_rdram;
+    };
+
+    // Native IOP heap: well above the IOP model's module and allocation area, so routing by address is unambiguous.
+    constexpr uint32_t kNativeHeapStart = 0x140000u;
+    constexpr int32_t kNativeModuleIdBase = 0x1000;
+}
+
+bool ps2_native_sound_register_image(const bozo::native::irx::Image &image)
+{
+    registry().push_back(image);
+    return true;
+}
+
+struct PS2NativeSound::Impl
+{
+    PS2Runtime &runtime;
+    bozo::libs::Libraries libraries;
+    std::unique_ptr<bozo::native::irx::CompiledLibraries> host;
+    std::map<std::string, int32_t> started;
+    uint64_t eeCycle = 0;
+    int32_t nextModuleId = kNativeModuleIdBase;
+    bool optIn = false;
+    bool failed = false;
+    // A native host error is reported once; the driver then stops advancing (silence) instead of ending the game.
+    void fail(const char *what)
+    {
+        if (!failed) std::cerr << "[native-sound] stopped: " << what << std::endl;
+        failed = true;
+    }
+    std::vector<int16_t> pcm = std::vector<int16_t>(2 * 4096);
+
+    explicit Impl(PS2Runtime &rt) : runtime(rt)
+    {
+        const char *flag = std::getenv("PS2_PORT_NATIVE_SOUND");
+        optIn = flag && flag[0] == '1';
+    }
+
+    uint8_t *rdram() { return runtime.memory().getRDRAM(); }
+
+    bozo::native::irx::CompiledLibraries &ensureHost()
+    {
+        if (host) return *host;
+        libraries.clock = [this](bozo::libs::Guest &) { return eeCycle; };
+        libraries.sif.receiveCommand = [this](uint32_t command, std::span<const uint8_t> data, uint32_t destination,
+                                              std::span<const uint8_t> extra) -> uint32_t
+        {
+            if (destination && !extra.empty()) RdramGuest(rdram()).write(destination, extra.data(), uint32_t(extra.size()));
+            return ps2_stubs::dispatchSifCommand(rdram(), &runtime, command, data.data(), data.size()) ? 1u : 0u;
+        };
+        host = std::make_unique<bozo::native::irx::CompiledLibraries>(libraries, kNativeHeapStart);
+        host->useReadyAudioCompletions();
+        for (const auto &image : registry()) host->addImage(image);
+        return *host;
+    }
+};
+
+PS2NativeSound::PS2NativeSound(PS2Runtime &runtime) : m_impl(std::make_unique<Impl>(runtime)) {}
+PS2NativeSound::~PS2NativeSound() = default;
+
+bool PS2NativeSound::enabled() const { return m_impl->optIn && !registry().empty(); }
+
+ps2x::iop::ModuleLoadResult PS2NativeSound::loadModule(std::string_view path)
+{
+    ps2x::iop::ModuleLoadResult result{};
+    if (!enabled()) return result;
+    const std::string name = moduleName(path);
+    auto &p = *m_impl;
+    if (auto found = p.started.find(name); found != p.started.end())
+    {
+        result.handled = true;
+        result.moduleId = found->second;
+        result.startResult = 0;
+        return result;
+    }
+    const auto image = std::find_if(registry().begin(), registry().end(),
+                                    [&](const auto &i) { return moduleName(i.name) == name; });
+    const bool libsdServedNatively =
+        name == "LIBSD.IRX" && std::any_of(registry().begin(), registry().end(), [](const auto &i) {
+            return std::any_of(i.imports.begin(), i.imports.end(), [](const auto &imp) { return imp.library == "libsd"; });
+        });
+    if (image == registry().end() && !libsdServedNatively) return result;
+    if (image != registry().end())
+    {
+        const int32_t started = p.ensureHost().startImage(image->name);
+        std::cerr << "[native-sound] started " << image->name << " natively (" << started << ")" << std::endl;
+    }
+    else
+        std::cerr << "[native-sound] LIBSD.IRX served by the native libsd" << std::endl;
+    result.handled = true;
+    result.moduleId = p.nextModuleId++;
+    result.startResult = 0;
+    p.started.emplace(name, result.moduleId);
+    return result;
+}
+
+bool PS2NativeSound::serves(uint32_t sid) const
+{
+    return m_impl->host && m_impl->libraries.sif.servers.count(sid) != 0;
+}
+
+ps2x::iop::RpcResult PS2NativeSound::handleRpc(uint8_t *rdram, const ps2x::iop::RpcRequest &request)
+{
+    ps2x::iop::RpcResult result{};
+    auto &p = *m_impl;
+    const auto server = p.libraries.sif.servers.find(request.sid);
+    if (server == p.libraries.sif.servers.end()) return result;
+    RdramGuest guest(rdram);
+    try
+    {
+        server->second(p.libraries, guest,
+                       {request.function, request.send.address, request.send.size, request.receive.address,
+                        request.receive.size});
+    }
+    catch (const std::exception &error)
+    {
+        p.fail(error.what());
+    }
+    result.handled = true;
+    result.resultAddress = request.receive.address;
+    result.signalCompletion = true;
+    result.signalNowaitCompletion = true;
+    result.serverDispatchPolicy = ps2x::iop::ServerDispatchPolicy::Suppress;
+    return result;
+}
+
+bool PS2NativeSound::writeIopMemory(uint32_t address, const void *source, size_t size)
+{
+    auto &p = *m_impl;
+    if (!p.host || !size) return false;
+    try
+    {
+        (void)p.host->allocatedBuffer(address, uint32_t(size)); // throws unless inside a live native allocation
+    }
+    catch (const std::runtime_error &)
+    {
+        return false;
+    }
+    p.host->writeBuffer(address, static_cast<const uint8_t *>(source), uint32_t(size));
+    return true;
+}
+
+void PS2NativeSound::advanceEeCycles(uint64_t eeCycles)
+{
+    auto &p = *m_impl;
+    p.eeCycle += eeCycles;
+    if (!p.host) return;
+    if (p.failed) return;
+    try
+    {
+        auto *mixer = p.host->advanceTo(p.eeCycle);
+        if (!mixer) return;
+        while (true)
+        {
+            const size_t frames = mixer->take(p.pcm.data(), p.pcm.size() / 2);
+            if (!frames) break;
+            p.runtime.audioBackend().submitPcm(std::span<const int16_t>(p.pcm.data(), frames * 2));
+        }
+    }
+    catch (const std::exception &error)
+    {
+        p.fail(error.what());
+    }
+}
+
+bool PS2NativeSound::ownsAudio() const { return m_impl->host != nullptr && !m_impl->failed; }
diff --git a/ps2xRuntime/src/lib/native_sound/ps2_native_sound.h b/ps2xRuntime/src/lib/native_sound/ps2_native_sound.h
new file mode 100644
--- /dev/null
+++ b/ps2xRuntime/src/lib/native_sound/ps2_native_sound.h
@@ -0,0 +1,42 @@
+// Native IOP sound: a title's sound driver compiled ahead of time to C++ (BozoEngine tools/native_irx) runs on
+// BozoEngine's native IOP host and libsd mixer instead of the IOP interpreter and SPU2 model.
+// Opt-in per launch with PS2_PORT_NATIVE_SOUND=1, and only for modules whose compiled image was linked in.
+#pragma once
+#include "ps2x/iop/iop_types.h"
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+#include <string_view>
+
+class PS2Runtime;
+namespace bozo::native::irx
+{
+    struct Image;
+}
+
+// Called by generated code (static initializer) for each compiled IOP module image linked into the runner.
+bool ps2_native_sound_register_image(const bozo::native::irx::Image &image);
+
+class PS2NativeSound
+{
+  public:
+    explicit PS2NativeSound(PS2Runtime &runtime);
+    ~PS2NativeSound();
+    // True when the opt-in is set and at least one compiled image is linked.
+    bool enabled() const;
+    // Module load by path: starts a compiled image natively, or accepts libsd (served natively). handled=false
+    // leaves the module to the IOP subsystem.
+    ps2x::iop::ModuleLoadResult loadModule(std::string_view path);
+    bool serves(uint32_t sid) const;
+    ps2x::iop::RpcResult handleRpc(uint8_t *rdram, const ps2x::iop::RpcRequest &request);
+    // EE -> IOP SIF DMA into a native allocation; false when the address is not native.
+    bool writeIopMemory(uint32_t address, const void *source, size_t size);
+    // EE cycles elapsed: advances native IOP time and hands the mixed PCM to the audio backend.
+    void advanceEeCycles(uint64_t eeCycles);
+    // While native sound runs, the SPU2 model's output is not submitted.
+    bool ownsAudio() const;
+
+  private:
+    struct Impl;
+    std::unique_ptr<Impl> m_impl;
+};
